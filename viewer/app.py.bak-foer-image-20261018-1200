DATA_DIR = os.path.join(BASE_DIR, "data")


@app.route("/api/efterforskning")
def api_efterforskning():
    """EFTERFORSKNINGERNE — læses fra Flowsint (Neo4j), ikke den gamle graf.

    DNA 2026-10-16: Efterforskningsknappen skal pege på Flowsints Neo4j-database,
    hvor agenternes efterforskninger ligger. Hver efterforskning er et "sketch"
    (en graf); listen hentes fra /api/efterforskninger og grafen herfra via
    ?sketch_id=....

    Læses over Flowsint API'et (samme netværk), som selv læser Neo4j.
    """
    sketch_id = (__import__("flask").request.args.get("sketch_id") or "").strip()
    if not sketch_id:
        return jsonify({"nodes": [], "edges": [], "graph": "efterforskning",
                        "nodeCount": 0, "edgeCount": 0,
                        "fejl": "mangler sketch_id"}), 400
    try:
        data = _flowsint(f"/api/sketches/{sketch_id}/graph", {"format": "json"})
    except Exception as fejl:  # noqa: BLE001
        return jsonify({"nodes": [], "edges": [], "graph": "efterforskning",
                        "nodeCount": 0, "edgeCount": 0,
                        "fejl": f"kunne ikke nå Flowsint: {fejl}"}), 503
    nodes = []
    for nd in (data.get("nds") or []):
        props = nd.get("nodeProperties") or {}
        nodes.append({
            "id": str(nd.get("id") or ""),
            "label": str(nd.get("nodeLabel") or "?")[:50],
            "group": nd.get("nodeType") or "?",
            "age": nd.get("nodeType") or "?",
            "role": "",
            "props": props,
        })
    edges = []
    node_ids = {n["id"] for n in nodes}
    for rl in (data.get("rls") or []):
        src, tgt = str(rl.get("source") or ""), str(rl.get("target") or "")
        if src not in node_ids or tgt not in node_ids:
            continue
        edges.append({"id": str(rl.get("id") or ""), "from": src, "to": tgt,
                      "label": rl.get("label") or ""})
    return jsonify({
        "nodes": nodes, "edges": edges, "graph": "efterforskning",
        "nodeCount": len(nodes), "edgeCount": len(edges),
    })


@app.route("/api/efterforskninger")
def api_efterforskninger():
    """Liste over efterforskninger fra Flowsint — til rullemenuen i topbaren.

    Returnerer [{id, navn, sketches:[{id, title}]}] så knappen kan fyldes
    dynamisk. Når agenter laver nye efterforskninger i Flowsint, dukker de op
    her af sig selv.
    """
    try:
        inv = _flowsint("/api/investigations", {})
    except Exception as fejl:  # noqa: BLE001
        return jsonify({"efterforskninger": [], "fejl": str(fejl)}), 503
    ud = []
    for it in (inv or []):
        ud.append({
            "id": it.get("id"),
