        })
    return jsonify({"efterforskninger": ud})


def _flowsint(sti: str, params: dict):
    """Kald Flowsint API'et (samme netværk) med service-token. Read-only."""
    import urllib.parse
    import urllib.request
    url = os.environ.get("FLOWSINT_API", "http://Helix_Flowsint_API:5001") + sti
    if params:
        url += "?" + urllib.parse.urlencode(params)
    token = os.environ.get("FLOWSINT_TOKEN", "").strip()
    if not token:
        # Fald tilbage til token-filen (sat via docker, overlever su-proces-renset miljø).
        try:
            with open(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                   "flowsint_token"), encoding="utf-8") as fh:
                token = fh.read().strip()
        except Exception:  # noqa: BLE001
            token = ""
    req = urllib.request.Request(url)
    if token:
        req.add_header("Authorization", "Bearer " + token)
    with urllib.request.urlopen(req, timeout=15) as svar:
        return json.loads(svar.read().decode("utf-8"))


