@app.route("/api/ops_note")
def api_ops_note():
    """Læser ÉN note fra Obsidian-vaulten (kun læsning, kun .md i vaulten).

    Bruges når DNA klikker en boble i OPS-visningen og vil læse noten.
    """
    from flask import request
    sti = (request.args.get("sti") or "").strip()
    if not sti or ".." in sti or sti.startswith("__mappe__"):
        return jsonify({"error": "ugyldig sti"}), 400
    rod = os.environ.get("OBSIDIAN_VAULT", "/vault")
    fuld = os.path.normpath(os.path.join(rod, sti))
    if not fuld.startswith(os.path.normpath(rod)):
        return jsonify({"error": "uden for vaulten"}), 400
    if not fuld.lower().endswith(".md") or not os.path.isfile(fuld):
        return jsonify({"error": "noten findes ikke"}), 404
    with open(fuld, encoding="utf-8", errors="replace") as f:
        return jsonify({"sti": sti, "indhold": f.read()})


