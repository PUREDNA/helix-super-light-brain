// Tænd/sluk for HELE FAMILIEN: agenten og ALLE dens børn .
// Bruges af Alt-knappen ud for hver agents overskrift. Dobbeltklik på
// agentnavnet gør det samme (via dblKlik -> toggleLabel -> her).
function altEnLabel(key, el) {
  const alle = (dataAll.nodes || []);
  const tilhører = alle.filter(n => labelKey(n) === key);
  const børn = alle.filter(n => labelKey(n) === key && n.arbejde === '1');
  const familieTændt = tilhører.length > 0
    && !hiddenLabels.has(key)
    && børn.every(n => visteDele.has(key + '\u0001' + (n.del || '')));
  if (familieTændt) {
    // Sluk hele familien: agenten OG alle dens børn
    hiddenLabels.add(key);
    børn.forEach(n => visteDele.delete(key + '\u0001' + (n.del || '')));
  } else {
    // Tænd hele familien: agenten OG alle dens børn
    hiddenLabels.delete(key);
    børn.forEach(n => visteDele.add(key + '\u0001' + (n.del || '')));
  }
  savePrefs(); applyHidden(); renderLegend(); initNetwork();
}

