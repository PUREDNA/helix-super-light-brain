// ===== Labels er BØRN under domænet  =====
// Rækkefølgen: DOMÆNE (forælder) -> LABEL (barn) -> NAVN.
// Et klik på domænet slukker alt i det. Et klik på labelen slukker kun den.
// toggleLabel: DNA 2026-10-02 — tænder/slukker HELE FAMILIEN.
// Dobbeltklik på en overskrift (eller Alt-knappen) slukker agenten OG alle
// dens børn på ét tryk — som når man klikker et domæne i sidebar'en.
// Det gælder ALLE labels i ALLE domæner (Opgaver, podcast, juridiske
// sager …), så man ikke skal trykke hundrede knapper.
function toggleLabel(key, el) {
  const alle = (dataAll.nodes || []);
  const børn = alle.filter(n => labelKey(n) === key && n.arbejde === '1');
  const familieTændt = !hiddenLabels.has(key)
    && børn.every(n => visteDele.has(key + '\u0001' + (n.del || '')));
  if (familieTændt) {
    hiddenLabels.add(key);
    børn.forEach(n => visteDele.delete(key + '\u0001' + (n.del || '')));
  } else {
    hiddenLabels.delete(key);
    børn.forEach(n => visteDele.add(key + '\u0001' + (n.del || '')));
  }
  savePrefs(); applyHidden(); renderLegend(); initNetwork();
}

function labelKey(n) { return n.group + '\u0000' + (n.age || ''); }

// toggleAfsnit: DNA 2026-10-02 — dobbeltklik på en AFSNITS-OVERSKRIFT i
// labels (fx 'Juridiske sager', 'Opgaver', 'Agenter', 'podcast').
// Tænder/slukker for ALLE labels i den kategori på ét tryk, så man
// kan styre en hel kategori af gangen. Derefter tænder man enkeltvis.
function toggleAfsnit(g, el) {
  const alle = (dataAll.nodes || []);
  const keys = [...new Set(alle.filter(n => n.group === g).map(n => labelKey(n)))];
  const alleTændt = keys.length > 0 && keys.every(k => !hiddenLabels.has(k));
  if (alleTændt) {
    keys.forEach(k => {
      hiddenLabels.add(k);
      // sluk også kategorien børn
      alle.filter(n => labelKey(n) === k && n.arbejde === '1')
          .forEach(n => visteDele.delete(k + '\u0001' + (n.del || '')));
    });
  } else {
    keys.forEach(k => hiddenLabels.delete(k));
  }
  savePrefs(); applyHidden(); renderLegend(); initNetwork();
}

// toggleDel: DNA 2026-10-02 — dobbeltklik på et BARN under en agent.
//
// dine eksempel: inde i Agent One, dobbeltklik på 'noter' -> KUN hans
// noter bliver aktive. Dobbeltklik på 'Efterforskning' -> kun den.
// Derfor er børnene EKSKLUSIVE: når man tænder et barn, slukkes
// søskendene. Dobbeltklik igen på samme barn -> det slukkes (kun
// agenten tilbage). Forælderen tændes automatisk, så barnet kan ses.
function toggleDel(par, el) {
  const pkey = labelKey({ group: par[0], age: par[1] });
  const dkey = pkey + '\u0001' + par[2];
  const alle = (dataAll.nodes || []);
  const søskende = [...new Set(alle
    .filter(n => labelKey(n) === pkey && n.arbejde === '1')
    .map(n => pkey + '\u0001' + (n.del || '')))];

  if (visteDele.has(dkey)) {
    visteDele.delete(dkey);                 // sluk barnet
  } else {
    søskende.forEach(k => {                // sluk alle søskende
      if (k !== dkey) visteDele.delete(k);
    });
    visteDele.add(dkey);                    // tænd KUN dette barn
    hiddenLabels.delete(pkey);              // forælderen skal være tændt
  }
  const on = visteDele.has(dkey);
  el.classList.toggle('on', on);
  el.classList.toggle('off', !on);
  const k = el.querySelector('.legend-knap');
  if (k) k.textContent = on ? '●' : '○';
  savePrefs(); applyHidden(); renderLegend(); initNetwork();
}

// ===== ALT-eller-INTET pr. afsnit  =====
// Ud for hvert afsnit i sidebar'en — "Domæne" og "Labels" — står en knap
// der tænder eller slukker for HELE afsnittet på ét klik. Er noget tændt,
// står der "Skjul alle"; er alt slukket, står der "Vis alle".
// Bagefter kan man tænde dem en ad gangen med ●/○ ud for hver linje.
