        enabled: true,
        stabilization: { enabled: true, iterations: 250, updateInterval: 25 },
        solver: 'forceAtlas2Based',
        forceAtlas2Based: { gravitationalConstant: luftig ? -70 : -28,
                            centralGravity: luftig ? 0.006 : 0.015,
                            springLength: luftig ? 320 : 130,
                            springConstant: luftig ? 0.045 : 0.07, damping: 0.92,
                            barnesHutOptimize: true, barnesHutTheta: 0.5 },
        // DNA 3. nov 2026: "Projekter"-noden fløj rundt og kunne ikke rammes.
        // minVelocity 0.8 var for lav — simuleringen faldt aldrig til ro, fordi
        // tyngdekraften blev ved med at skubbe. 25 standser den, når den er
        // nogenlunde på plads, og så står noderne stille nok til at man kan
        // klikke på dem. stabilization giver den ro inden den vises.
        minVelocity: 25,
