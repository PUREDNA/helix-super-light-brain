// visteDele: hvilke af agenternes TING (børn) er tændt i grafen?
// DNA 2026-10-02: børnene er skjult som standard. Man tænder dem enkeltvis
// nede under agenten i sidebar'en. Dobbeltklik på agenten tænder/slukker
// hele familien (agenten + alle dens børn).
let visteDele = new Set();

// ===== DNA 2026-10-02: tre funktioner i sidebjælken =====
//   PEG på et domæne/label  -> alt der hører til LYSER i grafen (midlertidigt)
//   KLIK een gang            -> lyset HOLDER FAST, så man kan zoome rundt
//   DOBBELTKLIK              -> TÆNDER/SLUKKER (som enkeltklik gjorde før)
//
// Fremhævningen sker ved at DÆMPE alt andet — ikke ved at fjerne det —
// så man kan zoome ud og se helheden mens udvalget står klart.
let fastlåst = null;   // {type:'gruppe'|'label', værdi:'...'} eller null
let hoverAktiv = null;
// labelListe[i] = [gruppe, label] — labels læses herfra, ikke fra HTML,
// fordi NUL-tegnet i nøglen ikke overlever et HTML-attribut .
let labelListe = [];
// labelOverskrifter[i] = label-nøglen (gruppe + NUL + label) for hver overskrift
let labelOverskrifter = [];
// afsnitListe[i] = gruppenavnet for hver AFSNITS-overskrift i labels
// ('Agenter', 'Opgaver', 'Juridiske sager' …) — DNA 2026-10-02
let afsnitListe = [];

// Hvilke noder hører til et emne? Gruppe, afsnit, label eller barn.
function _emneNoder(type, værdi) {
  const alle = (dataAll && dataAll.nodes) || [];
  if (type === 'gruppe') return alle.filter(n => n.group === værdi);
  if (type === 'afsnit') return alle.filter(n => n.group === værdi);
  if (type === 'del') {
    const [g, a, d] = værdi;
    return alle.filter(n => n.group === g && (n.age || '?') === a && n.del === d);
  }
  const dele = String(værdi).split('\u0000');
  const g = dele[0], a = dele[1];
  return alle.filter(n => n.group === g && (n.age || '?') === a);
}

function _fremhæv(type, værdi) {
  if (!network || !window.gnet) return;
  if (type === 'kant') {
    // DNA 2026-10-16: peg/klik på en KANTTYPE lyser netop de kanter op i
    // grafen, så man kan se hvem der er bundet til hvem. Samme princip som
    // domæner/labels, bare på kanter i stedet for noder.
    const ramte = new Set((dataAll.edges || [])
      .filter(e => (e.label || '?') === værdi).map(e => String(e.id)));
    if (!ramte.size) return;
    const alleNoder = gnet.body.data.nodes.get({ returnType: 'Array' });
    gnet.body.data.nodes.update(alleNoder.map(n => ({ id: n.id, opacity: 0.15 })));
    const alleKanter = gnet.body.data.edges.get({ returnType: 'Array' });
    gnet.body.data.edges.update(alleKanter.map(e => ramte.has(String(e.id))
      ? { id: e.id, color: { color: '#7fd4ff', opacity: 1 }, width: 3 }
      : { id: e.id, color: { color: '#24507a', opacity: 0.06 }, width: 1 }));
    return;
  }
  const ramte = new Set(_emneNoder(type, værdi).map(n => String(n.id)));
  if (!ramte.size) return;
  const alleNoder = gnet.body.data.nodes.get({ returnType: 'Array' });
  gnet.body.data.nodes.update(alleNoder.map(n => ({
    id: n.id, opacity: ramte.has(String(n.id)) ? 1 : 0.12
  })));
  const alleKanter = gnet.body.data.edges.get({ returnType: 'Array' });
  gnet.body.data.edges.update(alleKanter.map(e => {
    const inde = ramte.has(String(e.from)) && ramte.has(String(e.to));
    return inde
      ? { id: e.id, color: { color: '#7fd4ff', opacity: 1 }, width: 2 }
      : { id: e.id, color: { color: '#24507a', opacity: 0.08 }, width: 1 };
  }));
}

function _rydFremhævning() {
  if (!network || !window.gnet) return;
  const alleNoder = gnet.body.data.nodes.get({ returnType: 'Array' });
  gnet.body.data.nodes.update(alleNoder.map(n => ({ id: n.id, opacity: 1 })));
  const alleKanter = gnet.body.data.edges.get({ returnType: 'Array' });
  gnet.body.data.edges.update(alleKanter.map(e => ({
    id: e.id, color: { color: '#24507a' }, width: 1
  })));
}

function pegPå(type, værdi, el) {
  if (fastlåst) return;             // intet hover mens noget er låst
  document.querySelectorAll('.legend-item.hover').forEach(x => x.classList.remove('hover'));
  if (el) el.classList.add('hover');
  hoverAktiv = { type, værdi };
  _fremhæv(type, værdi);
}

function pegVæk() {
  if (fastlåst) return;
  document.querySelectorAll('.legend-item.hover').forEach(x => x.classList.remove('hover'));
  hoverAktiv = null;
  _rydFremhævning();
}

function klikPå(type, værdi, el) {
  const samme = fastlåst && fastlåst.type === type && fastlåst.værdi === værdi;
  document.querySelectorAll('.legend-item.pinned').forEach(x => x.classList.remove('pinned'));
  if (samme) {                        // klik igen = slip
    fastlåst = null;
    sætStatus('Fremhævning sluppet');
    _rydFremhævning();
    return;
  }
  fastlåst = { type, værdi };
  if (el) el.classList.add('pinned');
  _fremhæv(type, værdi);
  const antal = type === 'kant'
    ? (dataAll.edges || []).filter(e => (e.label || '?') === værdi).length
    : _emneNoder(type, værdi).length;
  sætStatus('Holder fast: ' + antal + (type === 'kant' ? ' kanter' : ' noder') + ' — zoom frit rundt');
}

function dblKlik(type, værdi, el) {
  // dobbeltklik = tænd/sluk. Ryd fremhævning så man ser resultatet.
  fastlåst = null;
  document.querySelectorAll('.legend-item.pinned').forEach(x => x.classList.remove('pinned'));
  _rydFremhævning();
  if (type === 'gruppe') toggleGroup(værdi, el);
  else if (type === 'afsnit') toggleAfsnit(værdi, el);
  else if (type === 'del') toggleDel(værdi, el);
  else if (type === 'kant') toggleKantType(værdi, el);
  else toggleLabel(værdi, el);
}

function bindLegend(el, type, værdi) {
  // Et dobbeltklik udløser også to 'click' — derfor venter vi et kort
  // øjeblik før klik-handlingen, og aflyser den hvis dobbeltklikket kommer.
  let klikTimer = null;
  el.addEventListener('mouseenter', () => pegPå(type, værdi, el));
  el.addEventListener('mouseleave', () => pegVæk());
  el.addEventListener('click', () => {
    window.clearTimeout(klikTimer);
    klikTimer = window.setTimeout(() => klikPå(type, værdi, el), 220);
  });
  el.addEventListener('dblclick', (ev) => {
    ev.preventDefault();
    window.clearTimeout(klikTimer);   // aflys det ventende enkeltklik
    dblKlik(type, værdi, el);
  });
  // DNA 2026-10-02: INGEN tænd/sluk-knap pr. linje. ●/○ er ren INDIKATOR
  // for tilstanden. Alt styres med de TRE funktioner: peg, enkeltklik,
  // dobbeltklik — præcis som oppe i domænerne.
}

function renderLegend() {
  // Domæner = forældrene (grupperet på domene)
  const groups = [...new Set((dataAll.nodes||[]).map(n => n.group))].sort();
  // Labels = børnene, grupperet under hvert sit domæne
  const born = {};
  // born3[gruppe][label][del] = antal — labelens underopdeling
  const born3 = {};
  (dataAll.nodes||[]).forEach(n => {
    const g = n.group || '?';
    // DNA 2026-10-02: noder UDEN age (fx hele Efterforsknings-grafen fra
    // Flowsint) har ingen forælder/barn-struktur. De må IKKE havne i
    // label-listen — ellers kunne "skjul alle labels" skjule hele grafen
    // (den fejl kostede en undersøgelse).
    if (!n.age) return;
    const a = n.age;
    (born[g] = born[g] || {})[a] = (born[g][a] || 0) + 1;
    const dl = n.del || null;
    if (dl) {
      ((born3[g] = born3[g] || {})[a] = born3[g][a] || {})[dl] =
        (born3[g][a][dl] || 0) + 1;
    }
  });
  const domHtml = groups.map((g, i) => {
    const on = !hiddenGroups.has(g);
    const cnt = groupCounts[g] || '';
    return '<div class="legend-item legend-dom ' + (on?'on':'off') + '" data-dom="'+i+'" data-g="'+g+'">' +
      '<span class="status"></span>' +
      '<span class="dot" style="background:'+colorFor(g)+'"></span>' +
      '<span class="legend-navn">' + g + '</span><span class="legend-count">'+cnt+'</span>' +
      '</div>';
  }).join('');

  let labHtml = '';
  // DNA 2026-10-02 (ryddet): LABELS bruger PRÆCIS de samme tre funktioner
  // som domænerne — peg (lys op), enkeltklik (hold fast), dobbeltklik
  // (tænd/sluk). INGEN knapper pr. linje — ●/○ er ren indikator.
  // Kun de TO Alt-knapper i afsnitsoverskrifterne findes (Domæne + Labels).
  //
  // Trappestigen: agent (label) -> agentens ting (børn).
  //   dobbeltklik på AGENTEN     -> hele familien tændt/slukket
  //   dobbeltklik på et BARN     -> kun det barn tændt/slukket
  labelListe = [];
  labelOverskrifter = [];
  afsnitListe = [];
  groups.forEach(g => {
    const kids = Object.keys(born[g] || {}).sort();
    if (!kids.length) return;
    // DNA 2026-10-02: AFSNITS-OVERSKRIFTEN er klikbar med de TRE funktioner.
    //   peg          -> lyser hele kategorien op i grafen
    //   enkeltklik   -> holder den fast
    //   dobbeltklik  -> tænder/slukker for ALLE labels i kategorien
    // (fx 'Juridiske sager' -> alt under den slukkes på ét tryk)
    const aidx = afsnitListe.length;
    afsnitListe.push(g);
    const katKeys = kids.map(a => labelKey({ group: g, age: a }));
    const alleKatTændt = katKeys.length > 0 && katKeys.every(k => !hiddenLabels.has(k));
    labHtml += '<div class="legend-child-of ' + (alleKatTændt ? 'on' : 'off') + '" data-afsnit="' + aidx + '">' +
      '<span class="status"></span>' +
      '<span class="legend-navn">' + g + '</span>' +
      '<span class="legend-count">' + Object.values(born[g]).reduce((a,b)=>a+b,0) + '</span>' +
      '</div>';
    kids.forEach(a => {
      const key = labelKey({ group: g, age: a });
      const on = !hiddenLabels.has(key);
      const oidx = labelOverskrifter.length;
      labelOverskrifter.push(key);
      labHtml += '<div class="legend-item legend-lab-head ' + (on?'on':'off') + '" ' +
        'data-labhead="' + oidx + '">' +
        '<span class="status"></span>' +
        '<span class="dot" style="background:'+colorFor(g)+'"></span>' +
        '<span class="legend-navn">' + a + '</span>' +
        '<span class="legend-count">' + born[g][a] + '</span>' +
        '</div>';
      // === BØRNENE under agenten (dens ting) ===
      const dele = (born3[g] || {})[a];
      if (dele) {
        Object.keys(dele).sort().forEach(d => {
          const dkey = key + '\u0001' + d;
          const don = visteDele.has(dkey);
          const didx = labelListe.length;
          labelListe.push([g, a, d]);
          labHtml += '<div class="legend-item legend-del ' + (don?'on':'off') + '" ' +
            'data-lab="' + didx + '">' +
            '<span class="status"></span>' +
            '<span class="dot" style="background:'+colorFor(g)+';opacity:.45"></span>' +
            '<span class="legend-navn">' + d + '</span>' +
            '<span class="legend-count">' + dele[d] + '</span>' +
            '</div>';
        });
      }
    });
  });

  // ===== KANTTYPER (DNA 2026-10-16) =====
  // Ligesom domæner, men for kanter: hver kanttype kan tændes/slukkes hver for
  // sig. Så man fx kan sige "hvem har snakket med hvem" og kun se KENDER.
  const kantTal = {};
  (dataAll.edges || []).forEach(e => {
    const t = e.label || '?';
    kantTal[t] = (kantTal[t] || 0) + 1;
  });
  const kantNavne = Object.keys(kantTal).sort();
  let kantHtml = '<div class="lbl lbl-lab">Kanter — dobbeltklik: tænd/sluk en kanttype</div>';
  kantNavne.forEach(t => {
    const on = !hiddenEdgeTypes.has(t);
    kantHtml += '<div class="legend-item legend-kant ' + (on ? 'on' : 'off') + '" data-kant="' + t + '">' +
      '<span class="status"></span>' +
      '<span class="legend-knap">' + (on ? '●' : '○') + '</span>' +
      '<span class="legend-navn">' + t + '</span>' +
      '<span class="legend-count">' + kantTal[t] + '</span></div>';
  });

  document.getElementById('legend').innerHTML =
    '<div class="lbl lbl-dom">Domæne — peg: lys op · klik: hold fast · <b>●/○: tænd/sluk</b>' +
    ' <button class="alt-knap" id="alt-dom" onclick="altDom()">Skjul alle</button></div>' + domHtml +
    '<div class="legend-rule"></div>' +
    '<div class="lbl lbl-lab">Labels — børn under domænet. Under hver agent' +
    ' ligger dens ting (○ = skjult, ● = vist i grafen)' +
    ' <button class="alt-knap" id="alt-lab" onclick="altLab()">Skjul alle</button></div>' + labHtml +
    '<div class="legend-rule"></div>' + kantHtml;
  opdaterAltKnapper();

  // Bind KANTTYPERNE (DNA 2026-10-16): præcis som domæner/labels —
  // peg (lys op), enkeltklik (hold fast), dobbeltklik (tænd/sluk).
  document.querySelectorAll('#legend .legend-kant').forEach(el => {
    const t = el.dataset.kant;
    if (t == null) return;
    bindLegend(el, 'kant', t);
  });

  // Bind de tre funktioner (peg / klik / dobbeltklik) efter HTML er sat.
  const domEls = document.querySelectorAll('#legend .legend-dom');
  domEls.forEach(el => bindLegend(el, 'gruppe', el.dataset.g));
  // Label-overskrifter: hover/klik virker på hele labelen; Alt-knappen
  // tænder/slukker for labelen og alle dens dele på ét klik.
  // Label-overskrifter og børn bruger SAMME tre funktioner som domænerne:
  // peg / enkeltklik / dobbeltklik. Ingen knapper pr. linje.
  document.querySelectorAll('#legend .legend-lab-head').forEach(el => {
    const key = labelOverskrifter[Number(el.dataset.labhead)];
    if (!key) return;
    bindLegend(el, 'label', key);
  });
  document.querySelectorAll('#legend .legend-del').forEach(el => {
    const par = labelListe[Number(el.dataset.lab)];
    if (!par) return;
    bindLegend(el, 'del', par);
  });
  // AFSNITS-OVERSKRIFTERNE i labels : 'rod', 'Agenter',
  // 'Boxstation-tidslinje', 'Juridiske sager', 'Opgaver', 'podcast' …
  // Samme tre funktioner: peg / enkeltklik / dobbeltklik (tænd-sluk alt).
  document.querySelectorAll('#legend .legend-child-of').forEach(el => {
    const g = afsnitListe[Number(el.dataset.afsnit)];
    if (!g) return;
    bindLegend(el, 'afsnit', g);
  });
}

async function showSelected(n) {
  // DNA 2026-10-13: husk hvilken node man stod på — så en opdatering fører
  // tilbage til samme sted i samme visning.
  try { localStorage.setItem('viewer_sidste', JSON.stringify({ ds: aktivDS, id: String(n.id) })); } catch (e) {}
  // ===== Metadata-boks (venstre) =====
  const name = document.getElementById('meta-name');
  if (name) name.innerHTML = '<b>' + (n.label || '?') + '</b>';
  setEl('meta-type', n.group || '?');
  setEl('meta-rolle', n.role || '—');
  const props = (n.props && typeof n.props === 'object') ? n.props : {};
  // Tidsstempel + dato/dag — afhænger af nøgler i props
  let ts = props.timestamp || props.created_at || props.createdAt || '';
  setEl('meta-timestamp', ts ? formatTs(ts) : '—');
  const dato = props.dato || props.år || '';
  const dag = props.dag || '';
  setEl('meta-dato', [dato, dag ? ('dag ' + dag) : ''].filter(Boolean).join(' · ') || '—');

  // Øvrige metadata (alt uden for indhold-felterne)
  const contentKeys = ['indhold','content','body','tekst','besked','message','resume','note'];
  const extra = document.getElementById('meta-extra');
  let extraHtml = '';
  Object.keys(props).sort().forEach(k => {
    if (['rolle','timestamp','created_at','createdAt','dato','år','dag','indhold','content','body','tekst','besked','message','resume','note'].includes(k)) return;
    const v = props[k];
    if (v === null || v === undefined || v === '') return;
    extraHtml += '<div class="meta-row"><div class="k">' + k + '</div><div>' + String(v).slice(0, 200) + '</div></div>';
  });
  if (extra) extra.innerHTML = extraHtml;

  // ===== Indhold (højre, rulle) =====
  // FANER GRUPPERES PÅ KATEGORI (dine ordre 2026-09-29):
  // Felter navngives <kategori>_<felt> (fx kontakt_email, navn_fornavn).
  // Kategorien bliver ÉT faneblad - ikke ét faneblad pr. felt.
  // Gamle flade felter (uden "_") samles i "øvrige" + fane pr. tekst-felt.
  const tabs = document.getElementById('bottom-tabs');
  let allTabs = [];   // DNA 2026-10-17: skal kunne ses i baade kategori-greningen og den fælles del
  const scroll = document.getElementById('bottom-scroll');
  if (tabs) tabs.innerHTML = '';
  if (scroll) scroll.textContent = '';

  // ===== DAGBOG-FANEBLAD PR. AGENT (DNA 2026-10-20) =====
  // Hver agent har sin egen mappe under Agenter/Dagbog. Staar man paa agentens
  // node, kommer der et faneblad der aabner den NYESTE dagbogsfil direkte —
  // saa dagbogen kan laeses uden at lede i Obsidian.
  try {
    const AGENTER = ['helix','agent-one','bob-1','bob-2','bob-3','byggemand-bob',
                     'gemini-ingest','krypto','mr-x','pcb-per','poul-prompt','research',
                     'revisor','sekretaer','trailer-team'];
    const raa = [n.label, n.id, props.navn, props.name, props.agent]
      .filter(Boolean).map(x => String(x).toLowerCase().replace(/[_\s]+/g, '-'));
    const agentNavn = AGENTER.find(a => raa.some(r => r === a || r.indexOf(a) !== -1)) || '';
    if (agentNavn && tabs) {
      const stier = (await alleNoterStier()) || [];
      const pre = 'Agenter/Dagbog/' + agentNavn + '/';
      const kand = stier.filter(s => String(s).indexOf(pre) === 0).sort();
      const ny = kand.length ? kand[kand.length - 1] : '';
      const b = document.createElement('div');
      b.className = 'btab';
      b.textContent = 'dagbog' + (ny ? ' (' + String(ny).split('/').pop().replace('.md', '') + ')' : '');
      b.onclick = async () => {
        for (const el of tabs.children) el.classList.remove('active');
        b.classList.add('active');
        if (!ny) { scroll.textContent = 'Ingen dagbog for ' + agentNavn + ' endnu.'; return; }
        scroll.textContent = 'henter ' + ny + ' …';
        try {
          const d = await (await fetch('/api/note?sti=' + encodeURIComponent(ny))).json();
          scroll.textContent = d.tekst || ('fejl: ' + (d.fejl || 'noten kunne ikke laeses'));
        } catch (e) { scroll.textContent = 'fejl: ' + e; }
      };
      tabs.appendChild(b);
    }
  } catch (e) { /* dagbog er en hjaelpefane — den maa ikke blokere visningen */ }


  // De faste kategorier (rækkefølgen styrer fanebladenes rækkefølge)
  const KATEGORIER = ['navn','identitet','beskrivelse','kontakt','socialt','personligt',
                      'viden','arbejde','registrering','relation','direktion','meta'];
  const META_SKJUL = ['rolle','timestamp','created_at','createdAt','dato','år','dag'];

  // ===== MOC-NODER: fire FASTE faneblade  =====
  // "Alle noder der har noget med MOC at gøre skal have fire faneblade:
  //  direktion, noter, forbundet og oversigt." Forbundet bygges nedenfor.
  const erMoc = (n.group === 'MOC') || String(props.domene || '') === 'MOC';

  if (erMoc) {
    const mocTabs = [];

    // 1) DIREKTION — hvor man går videre hen
    const dirFelter = Object.keys(props)
      .filter(k => k.startsWith('direktion_'))
      .sort()
      .map(k => ({ navn: k.slice('direktion_'.length), værdi: String(props[k] || '') }));
    let dirTxt = '';
    if (dirFelter.length) {
      dirFelter.forEach(f => { dirTxt += f.navn + ': ' + (f.værdi || '(ingen)') + '\n'; });
      mocTabs.push({
        key: 'direktion (' + dirFelter.filter(f => f.værdi).length + '/' + dirFelter.length + ')',
        text: dirTxt
      });
    } else {
      mocTabs.push({ key: 'direktion (0)', text: 'Ingen direktioner registreret på denne node.\n' +
        'En direktion er en henvisning: hvor finder man mere om dette emne?\n' });
    }

    // 2) NOTER — nodens egen tekst
    const noteFelter = ['note', 'tekst', 'referat', 'resume', 'indhold', 'besked']
      .filter(k => props[k] && String(props[k]).trim());
    let noteTxt = '';
    noteFelter.forEach(k => { noteTxt += '[' + k + ']\n' + String(props[k]).trim() + '\n\n'; });
    if (!noteTxt) {
      // fald tilbage til de beskrivende felter
      Object.keys(props).sort().forEach(k => {
        if (k.startsWith('beskrivelse_') && props[k] && String(props[k]).trim()) {
          noteTxt += k.slice('beskrivelse_'.length) + ': ' + String(props[k]).trim() + '\n';
        }
      });
    }
    mocTabs.push({ key: 'noter (' + (noteTxt ? noteTxt.length : 0) + ')',
                   text: noteTxt || '(ingen note på denne node)' });

    // 3) OVERSIGT (emnetræer) — hvad der ligger UNDER noden
    // hentes async nedenfor; her lægges pladsholderen ind i rigtig rækkefølge
    mocTabs.push({ key: 'oversigt', text: '(henter...)' });

    // byg fanerne
    let aktiv = mocTabs[0].key;
    mocTabs.forEach((t, i) => {
      const b = document.createElement('div');
      b.className = 'btab' + (i === 0 ? ' active' : '');
      b.textContent = t.key;
      b.onclick = () => {
        aktiv = t.key;
        for (let k = 0; k < tabs.children.length; k++) tabs.children[k].classList.toggle('active', k === i);
        scroll.textContent = mocTabs[i].text;
      };
      tabs.appendChild(b);
    });
    scroll.textContent = mocTabs[0].text;

    // fyld oversigt-fanen med børnene. I OPS slås op lokalt (ids er filstier).
    try {
      let nb = null;
      if (aktivHjerne === 'OPS') {
        nb = naboerLokalt(n);
      } else {
        const res = await fetch('api/neighbors?id=' + encodeURIComponent(n.id));
        nb = await res.json();
      }
      let ovTxt = '';
      if (nb && nb.match && nb.nodes && nb.nodes.length > 1) {
        const center = String(n.id);
        const børn = nb.nodes.filter(x => String(x.id) !== center);
        const grupper = {};
        børn.forEach(c => {
          const rels = (nb.edges || [])
            .filter(e => (String(e.from) === center && String(e.to) === String(c.id)) ||
                         (String(e.to) === center && String(e.from) === String(c.id)))
            .map(e => e.label);
          const rel = rels.length ? rels[0] : '?';
          (grupper[rel] = grupper[rel] || []).push(c);
        });
        ovTxt = 'Under "' + (n.label || '?') + '" (' + børn.length + '):\n\n';
        Object.keys(grupper).sort().forEach(rel => {
          ovTxt += '— ' + rel + ' (' + grupper[rel].length + ') —\n';
          grupper[rel].sort((a, b) => String(a.label).localeCompare(String(b.label), 'da'))
            .forEach(c => { ovTxt += '   ' + (c.label || c.id) + '\n'; });
          ovTxt += '\n';
        });
      } else {
        ovTxt = '(ingen emner under denne node)';
      }
      const idx = mocTabs.findIndex(t => t.key === 'oversigt');
      if (idx >= 0) {
        mocTabs[idx].text = ovTxt;
        if (tabs.children[idx] && tabs.children[idx].classList.contains('active')) {
          scroll.textContent = ovTxt;
        }
      }
    } catch (e) {
      console.error('oversigt-fejl:', e && e.message ? e.message : e);
      /* oversigt er en hjælpefane */
    }

  } else {

  const katIndhold = {};     // kategori -> [{navn, værdi}]
  const tekstFaner = [];     // fane pr. frit tekstfelt
  const fladeIndhold = {};   // DNA 2026-10-16: flade felter -> navngivne faner
  const øvrige = [];        // resterende flade felter uden kategori

  // DNA 2026-10-16: flade felter (uden kategori-præfiks) skal også have
  // ordentlige faneblade — ikke klumpes i "øvrige". Konklusion/Emne-noder har
  // fx bevis/niveau/emne/observer der hører sammen, og kategori/domene/type
  // der beskriver tilhørsforholdet.
  const FLADE = {
    'bevis': 'egenskaber', 'niveau': 'egenskaber', 'emne': 'egenskaber', 'observer': 'egenskaber',
    'kategori': 'tilhørsforhold', 'domene': 'tilhørsforhold', 'type': 'tilhørsforhold',
    'slags': 'tilhørsforhold', 'entitet': 'tilhørsforhold',
    'sti': 'oprindelse', 'kilde': 'oprindelse', 'oprindelse': 'oprindelse',
    'gammel_id': 'oprindelse', 'fra_gammel_graf': 'oprindelse',
  };

  Object.keys(props).forEach(k => {
    const v = props[k];
    const tom = (v === null || v === undefined || String(v).trim() === '');
    // frit tekstfelt (indhold/tekst/besked) bliver sin egen fane
    if (contentKeys.includes(k)) {
      if (!tom) tekstFaner.push({ key: k, text: String(v).trim() });
      return;
    }
    if (META_SKJUL.includes(k)) return;
    const i = k.indexOf('_');
    const kat = i > 0 ? k.slice(0, i) : null;
    if (kat && KATEGORIER.includes(kat)) {
      if (!katIndhold[kat]) katIndhold[kat] = [];
      katIndhold[kat].push({ navn: k.slice(i + 1), værdi: tom ? '' : String(v) });
      return;
    }
    if (tom) return;
    const fladeFane = FLADE[k];
    if (fladeFane) {
      if (!fladeIndhold[fladeFane]) fladeIndhold[fladeFane] = [];
      fladeIndhold[fladeFane].push({ navn: k, værdi: String(v) });
    } else {
      øvrige.push({ navn: k, værdi: String(v) });
    }
  });

  // byg faneliste: kategori-faner først, så tekst-faner, så flade faner, så øvrige
  allTabs = [];        // fyldes af kategori-greningen
  KATEGORIER.forEach(kat => {
    const felter = katIndhold[kat];
    if (!felter || !felter.length) return;
    felter.sort((a, b) => a.navn.localeCompare(b.navn, 'da'));
    const udfyldt = felter.filter(f => f.værdi).length;
    let txt = '';
    felter.forEach(f => {
      txt += f.navn + ': ' + (f.værdi || '(mangler oplysning)') + '\n';
    });
    allTabs.push({ key: kat + ' (' + udfyldt + '/' + felter.length + ')', text: txt });
  });
  tekstFaner.forEach(t => allTabs.push({ key: t.key + ' (' + t.text.length + ')', text: t.text }));
  // flade faner i fast rækkefølge (DNA 2026-10-16)
  // DNA 2026-10-17: egenskaber og tilhoersforhold samles med oevrige i ÉT faneblad,
  // saa der staar seks: sti, informationscenter, mappe, MD, forbundet, oevrige.
  let øvrigeTxt = '';
  ['egenskaber', 'tilhørsforhold'].forEach(fane => {
    const felter = fladeIndhold[fane];
    if (!felter || !felter.length) return;
    felter.sort((a, b) => a.navn.localeCompare(b.navn, 'da'));
    øvrigeTxt += '— ' + fane + ' —\n';
    felter.forEach(f => { øvrigeTxt += f.navn + ': ' + f.værdi + '\n'; });
    øvrigeTxt += '\n';
  });
  if (øvrige.length) {
    øvrigeTxt += '— øvrige —\n';
    øvrige.forEach(f => { øvrigeTxt += f.navn + ': ' + f.værdi + '\n'; });
  }
  if (øvrigeTxt.trim()) allTabs.push({ key: 'vektra-øvrig (' + (øvrige.length || 0) + ')', text: øvrigeTxt });

  // DNA 2026-10-17: en node uden registreret indhold maa IKKE efterlade en tom
  // informationslinje. Vi gaar videre herfra, saa de faste faneblade alligevel
  // bliver bygget — og "oevrige" siger aerligt, at der intet er registreret.
  if (!allTabs.length) {
    allTabs.push({ key: 'vektra-øvrig (0)', text: '(denne node har ingen registreret indhold)\n' });
  }
  let activeKey = allTabs[0].key;
  allTabs.forEach((t, i) => {
    const b = document.createElement('div');
    b.className = 'btab' + (i === 0 ? ' active' : '');
    b.textContent = t.key;
    b.onclick = () => {
      activeKey = t.key;
      for (let k = 0; k < tabs.children.length; k++) tabs.children[k].classList.toggle('active', k === i);
        scroll.textContent = allTabs[i].text;
    };
    tabs.appendChild(b);
  });
  scroll.textContent = allTabs[0].text;

  }  // slut på MOC/normal-greningen

  // ===== NODENS STED OG STRUKTUR — SAMME FANEBLADE PÅ ALLE NODER =====
  // DNA 2026-10-13: alle noder skal have samme opbygning, så vi får lige meget
  // ud af dem. Tre faste faneblade først:
  //   ① sti     — hvor noden ligger (til at dirigere AI'en hen til placeringen)
  //   ② mapper  — hvilke mapper der ligger under den (klikbare: gå ind i dem)
  //   ③ MD      — hvilke MD-filer der ligger under den (klikbare: læs dem)
  // Træet vokser med tiden, så fanebladene viser hvad der ER — ikke hvad der
  // var. Klik på en mappe -> ind i den. Klik på en MD -> noten læses nedunder.
  {
    const aabnPanel = () => {
      const panel = document.getElementById('bottom-panel');
      if (!panel) return;
      panel.classList.remove('closed');
      const h = parseInt(panel.style.height || '0', 10);
      if (!h || h < 160) panel.style.height = '300px';
    };
    const mine = [];                 // vore faste faneblade, i rækkefølge
    const fane = (navn, indhold, valgt) => {
      const knap = document.createElement('div');
      knap.className = 'btab';
      knap.textContent = navn;
      knap.onclick = () => {
        Array.prototype.forEach.call(tabs.children, c => c.classList.remove('active'));
        knap.classList.add('active');
        scroll.textContent = '';
        if (typeof indhold === 'string') scroll.textContent = indhold;
        else scroll.appendChild(indhold);
      };
      mine.push(knap);
      return { navn: navn, knap: knap, valgt: !!valgt };
    };
    const erMappeNode = (x) => String((x && x.id) || '').startsWith('__mappe__');
    const propsAf = (x) => (x && x.props && typeof x.props === 'object') ? x.props : {};
    const stiFor = (x) => {
      const pr = propsAf(x);
      if (String(pr.sti || '').trim()) return String(pr.sti).trim();
      if (erMappeNode(x)) return String(x.id).replace('__mappe__/', '');
      const p = pr.sti || pr.path || pr.fil || pr.filnavn || '';
      return String(p || '').trim();
    };
    const mappeStiFor = (x) => erMappeNode(x)
      ? String(x.id).replace('__mappe__/', '')
      : String(propsAf(x).mappe || '').trim();
    const alle = filterFullNodes();
    const klikbar = (x) => {
      const rad = document.createElement('div');
      rad.style.cssText = 'margin:4px 0';
      const a = document.createElement('a');
      a.href = '#';
      a.textContent = (erMappeNode(x) ? '🗂 ' : '📄 ') + (x.label || '?') +
                      (erMappeNode(x) ? '' : '  (' + (stiFor(x) || '?') + ')');
      a.style.cssText = 'color:#7dd3fc;text-decoration:underline;cursor:pointer';
      a.onclick = (ev) => {
        ev.preventDefault();
        const mål = filterFullNodes().find(y => String(y.id) === String(x.id));
        if (mål) {
          visNode(mål);
          if (window.gnet) window.gnet.selectNodes([String(x.id)]);
        }
      };
      rad.appendChild(a);
      return rad;
    };
    // DNA 2026-10-17: dobbeltklik paa en MD-fil -> eget vindue med laesning + download.

    // DNA 2026-10-17: læseren ligger i SELVE panelet — nye vinduer blokeres, naar
    // vieweren kører inde i et panel (iframe). Her kan man læse, rulle og hente filen.
    const aabnLæser = async (sti, navn) => {
      let box = document.getElementById('laeser-boks');
      if (!box) {
        box = document.createElement('div');
        box.id = 'laeser-boks';
        box.style.cssText = 'position:fixed;left:10px;right:10px;top:10px;bottom:10px;background:#0b1220;' +
          'border:2px solid #334155;border-radius:10px;z-index:99999;padding:14px;display:flex;flex-direction:column;' +
          'box-shadow:0 10px 40px #000c';
        const hoved = document.createElement('div');
        hoved.style.cssText = 'display:flex;gap:8px;align-items:center;margin-bottom:8px';
        const titel = document.createElement('div');
        titel.id = 'laeser-titel';
        titel.style.cssText = 'flex:1;font-weight:bold;color:#e2e8f0;font-size:13px;overflow:hidden;text-overflow:ellipsis';
        const kn = (tekst, f) => {
          const b = document.createElement('button');
          b.textContent = tekst;
          b.style.cssText = 'background:#1e293b;color:#e2e8f0;border:1px solid #334155;border-radius:6px;padding:4px 10px;cursor:pointer';
          b.onclick = f;
          return b;
        };
        hoved.appendChild(titel);
        hoved.appendChild(kn('Hent ned', () => {
          const b = new Blob([box.dataset.tekst || ''], { type: 'text/markdown;charset=utf-8' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(b);
          a.download = box.dataset.navn || 'fil.md';
          document.body.appendChild(a); a.click(); a.remove();
        }));
        hoved.appendChild(kn('Udskriv', () => window.print()));
        hoved.appendChild(kn('Luk', () => box.remove()));
        const pre = document.createElement('pre');
        pre.id = 'laeser-tekst';
        pre.style.cssText = 'flex:1;overflow:auto;white-space:pre-wrap;word-wrap:break-word;background:#111c2e;' +
          'border:1px solid #334155;border-radius:8px;padding:14px;color:#e2e8f0;margin:0;font-size:13px;line-height:1.45';
        box.appendChild(hoved);
        box.appendChild(pre);
        document.body.appendChild(box);
      }
      box.dataset.navn = navn || String(sti).split('/').pop();
      box.dataset.tekst = '';
      document.getElementById('laeser-titel').textContent = box.dataset.navn + '   —   ' + sti;
      document.getElementById('laeser-tekst').textContent = '(henter ...)';
      try {
        const svar = await fetch('/api/note?sti=' + encodeURIComponent(sti));
        const d = await svar.json();
        box.dataset.tekst = d.tekst || '';
        document.getElementById('laeser-tekst').textContent =
          box.dataset.tekst || ('(kunne ikke læses: ' + (d.fejl || 'ukendt') + ')');
      } catch (e) {
        document.getElementById('laeser-tekst').textContent = '(fejl: ' + e.message + ')';
      }
    };

    const aabnNoteVindue = async (x) => {
      const sti = String((propsAf(x) || {}).sti || stiFor(x) || '').trim();
      if (!sti) { alert('Ingen sti paa denne fil.'); return; }
      const navn = sti.split('/').pop();
      const v = window.open('', '_blank');
      if (!v) { await aabnLæser(sti, navn); return; }
      v.document.write('<html><head><meta charset="utf-8"><title>' + navn +
        '</title><style>body{background:#0b1220;color:#e2e8f0;font-family:Segoe UI,sans-serif;' +
        'margin:0;padding:18px}h2{margin:0 0 4px;font-size:15px}.sti{color:#7c8ba1;font-size:12px;' +
        'margin-bottom:10px}pre{white-space:pre-wrap;word-wrap:break-word;background:#111c2e;' +
        'border:1px solid #334155;border-radius:8px;padding:14px;line-height:1.45;font-size:13px}' +
        'button{background:#1e293b;color:#e2e8f0;border:1px solid #334155;border-radius:6px;' +
        'padding:6px 12px;cursor:pointer;margin-right:8px}button:hover{border-color:#00e5ff}' +
        '</style></head><body><h2>' + navn + '</h2><div class="sti">' + sti +
        '</div><div><button id="dl">Hent filen ned</button><button id="pr">Udskriv</button></div>' +
        '<pre id="txt">(henter ...)</pre></body></html>');
      v.document.close();
      try {
        const svar = await fetch('/api/note?sti=' + encodeURIComponent(sti));
        const d = await svar.json();
        v.document.getElementById('txt').textContent =
          d.tekst || ('(kunne ikke laeses: ' + (d.fejl || 'ukendt') + ')');
        v.__tekst = d.tekst || '';
      } catch (e) {
        v.document.getElementById('txt').textContent = '(fejl: ' + e.message + ')';
        v.__tekst = '';
      }
      v.document.getElementById('dl').onclick = () => {
        const b = new Blob([v.__tekst || ''], { type: 'text/markdown;charset=utf-8' });
        const a = v.document.createElement('a');
        a.href = URL.createObjectURL(b); a.download = navn;
        v.document.body.appendChild(a); a.click(); a.remove();
      };
      v.document.getElementById('pr').onclick = () => v.print();
    };

    const listeAf = (xs, tomTekst, sorter = true) => {
      const wrap = document.createElement('div');
      if (!xs.length) { wrap.textContent = tomTekst; return wrap; }
      const l = sorter ? xs.slice().sort((a, b) => String(a.label).localeCompare(String(b.label), 'da')) : xs;
      l.forEach(x => wrap.appendChild(klikbar(x)));
      return wrap;
    };
    // hvad ligger DER UNDER denne node?
    const mappeSti = mappeStiFor(n);
    let under = [], noterHer = [];
    if (mappeSti) {
      under = alle.filter(x => erMappeNode(x) &&
        String(x.id).replace('__mappe__/', '').split('/').slice(0, -1).join('/') === mappeSti &&
        String(x.id).replace('__mappe__/', '') !== mappeSti);
      noterHer = alle.filter(x => !erMappeNode(x) && String(propsAf(x).mappe || '') === mappeSti);
    }
    // DNA 2026-10-17: grafnoder (Super Brain) har ingen __mappe__-noder. Byg derfor
    // mapper og MD af grafens EGNE boern og af nodens sti (sti -> moenster -> filer).
    const erGrafNode = (aktivHjerne !== 'OPS');
    const propsG = propsAf(n) || {};
    // DNA 2026-10-17: stien kan staa tre steder — i props, i id'et paa en
    // OPS-mappenode (__mappe__/Agenter/Helix) eller i props.path/fil. Foer læste
    // vi KUN props.sti, og saa stod mappe og MD paa 0 for alle mappenoder.
    const stiG = (() => {
      const s = String(propsG.sti || '').trim();
      if (s) return s;
      const id = String(n.id);
      if (id.indexOf('__mappe__/') === 0) return id.slice('__mappe__/'.length);
      return String(propsG.path || propsG.fil || propsG.filnavn || '').trim();
    })();
    const børnG = () => {
      const id = String(n.id);
      return (dataAll.edges || [])
        .filter(e => String(e.from) === id)
        .map(e => alle.find(y => String(y.id) === String(e.to)))
        .filter(Boolean);
    };
    const nodeVedSti = (s) => alle.find(x => String(propsAf(x).sti || '').trim() === s);
    const filerG = () => String(propsG.filer || '').split(';').map(x => x.trim()).filter(Boolean);
    const gaaTil = (maal) => {
      const m = alle.find(y => String(y.id) === String(maal.id));
      if (!m) return;
      visNode(m);
      if (window.gnet) window.gnet.selectNodes([String(maal.id)]);
    };
    const opKnap = () => {
      if (!stiG || !stiG.includes('/')) return null;
      const forælderSti = stiG.split('/').slice(0, -1).join('/');
      const knap = document.createElement('div');
      knap.textContent = '↑ Op til ' + forælderSti;
      knap.style.cssText = 'cursor:pointer;font-weight:bold;color:#fbbf24;margin:2px 0 8px';
      knap.title = 'Klik for at gaa et niveau op i mappestrukturen';
      knap.onclick = (ev) => {
        ev.preventDefault();
        const m = nodeVedSti(forælderSti);
        if (m) gaaTil(m); else alert('Ingen node for ' + forælderSti + ' i denne database.');
      };
      return knap;
    };

    const erMappe = erMappeNode(n);
    // ① sti — hvor ligger den (til at dirigere AI'en)
    const sti = stiFor(n);
    const stiFane = fane('sti', sti
      ? ('📍 ' + sti + '\n\n' +
         '— peg her for at dirigere AI\'en til denne placering —\n' +
         'type:   ' + (erMappe ? 'mappe' : 'MD-fil') + '\n' +
         'mappe:  ' + (mappeSti || '(roden)') + '\n' +
         'domæne: ' + (n.group || '?'))
      : ('(ingen sti registreret på denne node)\n\n' +
         'node:  ' + (n.label || '?') + '\n' +
         'type:  ' + (n.group || '?') + '\n' +
         'domæne: ' + (n.group || '?')), false);
    // DNA 2026-10-17: sti-fanebladet samler ALT om stier — ogsaa henvisninger til
    // hvor det samme emne ligger andre steder, saa man dirigeres videre selv.
    if (stiFane && stiFane.knap && sti.includes('/')) {
      const emne = sti.split('/').filter(Boolean).pop();
      const top = sti.split('/')[0];
      let hentet = false;
      stiFane.knap.addEventListener('click', async () => {
        if (hentet) return;
        hentet = true;
        const alle = await alleNoterStier();
        const ramte = alle.filter(x => x.split('/').includes(emne) && x.split('/')[0] !== top);
        const prTop = {};
        ramte.forEach(x => { const t0 = x.split('/')[0]; prTop[t0] = (prTop[t0] || 0) + 1; });
        let txt = '\n— samme emne andre steder (' + ramte.length + ' filer) —\n';
        Object.keys(prTop).sort().forEach(t0 => { txt += '   ' + t0 + ' (' + prTop[t0] + ')\n'; });
        txt += '\n— mappeindeks —\n';
        txt += '   denne node:  ' + sti + '\n';
        txt += '   ligger i:    ' + sti.split('/').slice(0, -1).join('/') + '\n';
        if (ramte.length) { txt += '\n   eksempler:\n'; ramte.slice(0, 12).forEach(x => { txt += '   · ' + x + '\n'; }); }
        const s2 = document.getElementById('bottom-scroll');
        if (s2) s2.textContent = (s2.textContent || '') + txt;
      });
    }

    // ② mapper — hvad der ligger under den
    // DNA 2026-10-17: mapper og MD bygges af BIBLIOTEKETS struktur (ikke grafens kanter),
    // saa fanebladene virker i alle datasat. Man kan gaa ned og op igen.
    const visFane = (navn, antal, indhold) => {
      Array.prototype.forEach.call(tabs.children, c => {
        if (c.textContent.indexOf(navn + ' (') === 0) c.remove();
      });
      const knap = document.createElement('div');
      knap.className = 'btab';
      knap.textContent = navn + ' (' + antal + ')';
      knap.onclick = () => {
        Array.prototype.forEach.call(tabs.children, c => c.classList.remove('active'));
        knap.classList.add('active');
        scroll.textContent = '';
        if (typeof indhold === 'string') scroll.textContent = indhold;
        else scroll.appendChild(indhold);
      };
      tabs.appendChild(knap);
      return knap;
    };
    const opLinje = (foraelder, gaa) => {
      const op = document.createElement('div');
      op.textContent = '↑ Op til ' + (foraelder || '(roden)');
      op.style.cssText = 'cursor:pointer;font-weight:bold;color:#fbbf24;margin:2px 0 8px';
      op.title = 'Klik for at gaa et niveau op i mappestrukturen';
      op.onclick = (ev) => { ev.preventDefault(); gaa(foraelder || ''); };
      return op;
    };
    let stiFil = '';
    let egneFiler = [];
    let antalMapper = 0;
    let antalFiler = 0;
    let aktivViser = 'mappe';
    const byggMapperOgMD = async (sti) => {
      aktivViser = 'mappe';
      let mk = { mapper: [], foraelder: '' }, mf = { filer: [] };
      try {
        mk = await (await fetch('/api/mapper?sti=' + encodeURIComponent(sti))).json();
        mf = await (await fetch('/api/mdfiler?sti=' + encodeURIComponent(sti))).json();
      } catch (e) { /* vis tomt */ }
      // Nodens egen fil ligger ØVERST i dens mappe. Find den der, ikke i undermapperne.
      const dybde = (p) => p.split('/').length;
      antalMapper = (mk.mapper || []).length;
      antalFiler = (mf.filer || []).length;
      egneFiler = (mf.filer || []).filter(f => f.indexOf(sti + '/') === 0 && dybde(f) === dybde(sti) + 1);
      const kandidater = egneFiler.length ? egneFiler : (mf.filer || []);
      const erInfo = (f) => f.toLowerCase().indexOf('informationscenter') >= 0;
      const erOversigt = (f) => /^(info|_?oversigt)\b/i.test(f.split('/').pop());
      stiFil = kandidater.find(erInfo) || kandidater.find(erOversigt) || '';
      const mw = document.createElement('div');
      mw.appendChild(opLinje(mk.foraelder, byggMapperOgMD));
      (mk.mapper || []).forEach(m => {
        const el = document.createElement('div');
        el.textContent = '🗂 ' + m.navn;
        el.style.cssText = 'cursor:pointer;color:#7dd3fc;margin:3px 0;text-decoration:underline';
        el.title = 'Klik for at gaa ind i ' + m.navn;
        el.onclick = (ev) => { ev.preventDefault(); byggMapperOgMD(m.sti); };
        mw.appendChild(el);
      });
      if (!(mk.mapper || []).length) mw.appendChild(document.createTextNode('(ingen undermapper her)'));
      const fw = document.createElement('div');
      fw.appendChild(opLinje(mk.foraelder, byggMapperOgMD));
      (mf.filer || []).forEach(f => {
        const navn = f.split('/').pop();
        const el = document.createElement('div');
        el.textContent = '📄 ' + navn;
        el.title = f + '  —  klik for at aabne i eget vindue';
        el.style.cssText = 'cursor:pointer;color:#7dd3fc;margin:3px 0;text-decoration:underline';
        el.onclick = (ev) => { ev.preventDefault(); aabnLæser(f, navn); };
        fw.appendChild(el);
      });
      if (!(mf.filer || []).length) fw.appendChild(document.createTextNode('(ingen MD-filer her)'));
      const kMD = visFane('MD', (mf.filer || []).length, fw);
      const kMap = visFane('mappe', (mk.mapper || []).length, mw);
      if (aktivViser === 'mappe' && kMap) kMap.onclick();
    };
    // DNA 2026-10-17: fanebladet hedder INFORMATIONSCENTER og viser filens indhold.
    const byggInformationscenter = async (fil, egne) => {
      if (!fil) {
        // Ingen informationscenter-fil for denne node endnu — vis dog nodens egne filer.
        const tom = document.createElement('div');
        tom.textContent = 'Denne node har endnu ingen informationscenter-fil.';
        tom.style.cssText = 'color:#fbbf24;margin:0 0 8px';
        if ((egne || []).length) {
          const h = document.createElement('div');
          h.textContent = 'Filer i nodens egen mappe:';
          h.style.cssText = 'color:#94a3b8;margin:6px 0 4px';
          tom.appendChild(h);
          egne.forEach(f => {
            const a = document.createElement('div');
            const nm = f.split('/').pop();
            a.textContent = '· ' + nm;
            a.style.cssText = 'cursor:pointer;color:#7dd3fc;text-decoration:underline;margin:2px 0';
            a.onclick = () => aabnLæser(f, nm);
            tom.appendChild(a);
          });
        }
        visFane('informationscenter', (egne || []).length, tom);
        return;
      }
      const navn = fil.split('/').pop();
      const w = document.createElement('div');
      const lin = document.createElement('div');
      lin.textContent = '📄 ' + navn + '   (klik for at læse i eget felt)';
      lin.style.cssText = 'cursor:pointer;color:#7dd3fc;margin:0 0 8px;text-decoration:underline;font-weight:bold';
      lin.onclick = (ev) => { ev.preventDefault(); aabnLæser(fil, navn); };
      w.appendChild(lin);
      const pre = document.createElement('div');
      pre.textContent = '(henter ...)';
      pre.style.cssText = 'white-space:pre-wrap;word-wrap:break-word;background:#111c2e;border:1px solid #334155;' +
        'border-radius:8px;padding:10px;color:#e2e8f0;font-size:12px;line-height:1.4;max-height:260px;overflow:auto';
      w.appendChild(pre);
      try {
        const d = await (await fetch('/api/note?sti=' + encodeURIComponent(fil))).json();
        pre.textContent = d.tekst || ('(kunne ikke læses: ' + (d.fejl || 'ukendt') + ')');
      } catch (e) { pre.textContent = '(fejl: ' + e.message + ')'; }
      visFane('informationscenter', (pre.textContent || '').length, w);
      Array.prototype.forEach.call(tabs.children, c => {
        if (c.textContent.indexOf('oprindelse (') === 0) c.remove();
      });
    };

    if (stiG) {
      await byggMapperOgMD(stiG);
      await byggInformationscenter(stiFil, egneFiler);
    } else {
      // DNA 2026-10-17: selv uden sti skal informationslinjen staa ens — med
      // informationscenter, mappe og MD. Saa mangler der aldrig et faneblad.
      await byggInformationscenter('', []);
      fane('mappe (0)', '(denne node har ingen sti til et sted i biblioteket)', false);
      fane('MD (0)', '(ingen sti — kan ikke vise filer)', false);
    }
    // DNA 2026-10-17: "vektra-oevrig" baerer ALL data om noden — ogsaa den korte
    // oversigt der staar i panelet til venstre (type, rolle, mappe, tal, tid).
    {
      const øvPost = allTabs.find(x => x.key.indexOf('vektra-øvrig (') === 0);
      const øvKnap = Array.prototype.find.call(tabs.children, c => String(c.textContent).indexOf('vektra-øvrig (') === 0);
      if (øvPost) {
        let ov = '— oversigt —\n';
        ov += 'type:         ' + (n.group || '?') + '\n';
        ov += 'rolle:        ' + (n.role || '—') + '\n';
        ov += 'mappe:        ' + (stiG || '(ingen)') + '\n';
        ov += 'tidsstempel:  ' + (ts ? formatTs(ts) : '—') + '\n';
        ov += 'dato / dag:   ' + ([dato, dag ? ('dag ' + dag) : ''].filter(Boolean).join(' · ') || '—') + '\n';
        ov += 'antal noter:  ' + antalFiler + '\n';
        ov += 'antal mapper: ' + antalMapper + '\n';
        ov += 'sidst rørt:   ' + (ts ? formatTs(ts) : '(ikke registreret)') + '\n\n';
        øvPost.text = ov + øvPost.text;
        øvPost.key = 'vektra-øvrig (' + (antalFiler + antalMapper) + ')';
        if (øvKnap) øvKnap.textContent = øvPost.key;
      }
    }
    // ④ noten selv (kun når noden er en fil)
    if (!erMappe && String(propsAf(n).sti || '').trim()) {
      const fil = String(propsAf(n).sti).trim();
      let tekst;
      try {
        const svar = await fetch('/api/note?sti=' + encodeURIComponent(fil));
        const d = await svar.json();
        tekst = d.tekst || ('(noten kunne ikke læses: ' + (d.fejl || 'ukendt fejl') + ')');
      } catch (e) {
        tekst = '(kunne ikke hente noten: ' + e.message + ')';
      }
      fane('note (' + tekst.length + ')', '📄 ' + fil + '\n' + '─'.repeat(40) + '\n\n' + tekst, true);
    }
    // sæt de faste faneblade ind FOERST, i den rækkefølge de blev bygget
    mine.slice().reverse().forEach(k => tabs.insertBefore(k, tabs.firstChild));
    // aktivér: på en mappe 'mapper', på en fil 'note'
    const ønsket = erMappe ? 'mappe' : 'note';
    const valg = mine.find(k => k.textContent.startsWith(ønsket + ' ')) || mine[0];
    if (valg) valg.onclick();
    if (erMappe || String(propsAf(n).sti || '').trim()) aabnPanel();
  }

  // ===== 'Forbundet'-fane: hent naboer (dokumenter, personer, mailbox, sager osv.) =====
  // dine ordre 2026-09-29: hvert navn skal være KLIKBART og åbne den node.
  // DNA 2026-08-02: i OPS slås naboer op LOKALT i datasættet (ids er filstier,
  // ikke AGE-tal), så samme fane virker i begge hjerner.
  try {
    let neigh = null;
    if (aktivHjerne === 'OPS') {
      neigh = naboerLokalt(n);
    } else {
      const res = await fetch('api/neighbors?id=' + encodeURIComponent(n.id));
      neigh = await res.json();
    }
    if (!neigh || !neigh.match || !neigh.nodes || neigh.nodes.length <= 1) {
      // DNA 2026-10-02: MOC-noder SKAL have fire faneblade — så forbundet
      // tilføjes også når der ingen naboer er, med en tom besked.
      if (erMoc) {
        const b = document.createElement('div');
        b.className = 'btab';
        b.textContent = 'forbundet (0)';
        b.onclick = () => {
          Array.prototype.forEach.call(tabs.children, c2 => c2.classList.remove('active'));
          b.classList.add('active');
          scroll.textContent = '(ingen forbindelser registreret på denne node)';
        };
        tabs.appendChild(b);
      }
      return;
    }
    const center = neigh.nodes[0].id;

    // byg klikbar liste: hvert navn er et link der åbner naboen
    const wrap = document.createElement('div');
    const head = document.createElement('div');
    head.style.cssText = 'color:var(--muted);margin-bottom:8px';
    head.textContent = '— Forbundet til (' + (neigh.nodeCount - 1) + ') —';
    wrap.appendChild(head);

    const alleNoder = filterFullNodes();

    neigh.nodes.forEach(nb => {
      if (String(nb.id) === String(center)) return;
      const rels = neigh.edges
        .filter(e => (String(e.from) === String(center) && String(e.to) === String(nb.id)) ||
                     (String(e.to) === String(center) && String(e.from) === String(nb.id)))
        .map(e => e.label);
      const rel = (rels.length ? rels.join(', ') : '?');

      const rad = document.createElement('div');
      rad.style.cssText = 'margin:4px 0';
      const relSpan = document.createElement('span');
      relSpan.style.color = 'var(--muted)';
      relSpan.textContent = rel + '  →  ';
      rad.appendChild(relSpan);

      const a = document.createElement('a');
      a.href = '#';
      a.textContent = (nb.label || '?') + '  (' + (nb.group || '?') + ')';
      a.style.cssText = 'color:#7dd3fc;text-decoration:underline;cursor:pointer';
      a.onclick = (ev) => {
        ev.preventDefault();
        // find noden i datasættet og vis den — så man kan klikke videre
        const mål = alleNoder.find(x => String(x.id) === String(nb.id));
        if (mål) {
          visNode(mål);
          if (window.gnet) window.gnet.selectNodes([String(nb.id)]);
        }
      };
      rad.appendChild(a);
      wrap.appendChild(rad);
    });

    const b = document.createElement('div');
    b.className = 'btab';
    b.textContent = 'forbundet (' + (neigh.nodeCount - 1) + ')';
    b.onclick = () => {
      Array.prototype.forEach.call(tabs.children, c2 => c2.classList.remove('active'));
      b.classList.add('active');
      scroll.textContent = '';
      scroll.appendChild(wrap);
    };
    tabs.appendChild(b);
  } catch (e) {
    console.error('forbundet-fejl:', e && e.message ? e.message : e);
    // forbundet er en hjælpefane — men MOC-noder skal have den alligevel
    if (erMoc) {
      const b = document.createElement('div');
      b.className = 'btab';
      b.textContent = 'forbundet (0)';
      b.onclick = () => {
        Array.prototype.forEach.call(tabs.children, c2 => c2.classList.remove('active'));
        b.classList.add('active');
        scroll.textContent = '(kunne ikke hente forbindelser)';
      };
      tabs.appendChild(b);
    }
  }

  // ===== Vektra samlet i "vektra-oevrig" (DNA 2026-10-17) =====
  // Vektoren er broen mellem boblen i grafen og noterne i Ops. Den hentes foerst
  // naar man klikker paa fanebladet, saa panelet ikke skal vente paa den.
  {
    const øvPost = allTabs.find(x => x.key.indexOf('vektra-øvrig (') === 0);
    const øvKnap = Array.prototype.find.call(tabs.children, c => String(c.textContent).indexOf('vektra-øvrig (') === 0);
    if (øvPost && øvKnap && !øvKnap.dataset.vektra) {
      øvKnap.dataset.vektra = '1';
      let hentet = false;
      øvKnap.addEventListener('click', async () => {
        if (hentet) return;
        hentet = true;
        let vektTxt;
        if (aktivHjerne === 'OPS') {
          vektTxt = '(OPS-visningen har ingen MOC-vektorer — vektorene ligger i AG-hjernen)';
        } else {
          try {
            const res = await fetch('api/moc_vektorer?navn=' + encodeURIComponent(n.label || ''));
            const d = await res.json();
            const vs = (d && d.vektorer) || [];
            const navn = (d && d.navn) || n.label || '?';
            if (!vs.length) {
              vektTxt = 'Navn slået op: ' + navn + '\n\n' +
                '(ingen vektor knyttet til denne node)\n' +
                'Uden en vektor kan agenten ikke finde noden ved at søge.\n';
            } else {
              let txt = 'Navn slået op: ' + navn + '   (vektorer: ' + vs.length + ')\n';
              vs.forEach(v => {
                txt += '\n   navn:      ' + v.navn + '\n';
                txt += '   type:      ' + (v.type || '?') + '\n';
                txt += '   rolle:     ' + String(v.uddrag || '').split('\n')[0].slice(0, 200) + '\n';
                const mb = v.informationscenter || v.mappe;
                if (mb) txt += '   peger på:  Obsidian/' + mb + '/\n';
                if (v.workspace) txt += '   workspace: ' + v.workspace + '\n';
              });
              vektTxt = txt;
            }
          } catch (e) { vektTxt = '(kunne ikke hente vektorer: ' + e.message + ')'; }
        }
        øvPost.text += '\n— vektra —\n' + vektTxt;
        if (øvKnap.classList.contains('active')) document.getElementById('bottom-scroll').textContent = øvPost.text;
      });
    }
  }
  // Vektoren er broen mellem boblen i grafen og noterne i Ops.
}

