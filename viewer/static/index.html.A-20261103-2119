// ===== Bundpanel: dobbeltklik-kollaps + pil-toggle + drag-resize =====
(function setupBottomResize() {
  const panel = document.getElementById('bottom-panel');
  const handle = document.getElementById('bottom-handle');
  const chevron = document.getElementById('handle-chevron');
  if (!panel || !handle) return;
  let dragging = false;
  let openHeight = 240; // husk åben-højde når panelet kollapses

  function isClosed() { return panel.classList.contains('closed'); }
  function open() { panel.classList.remove('closed'); panel.style.height = openHeight + 'px'; }
  function close() { if (!isClosed()) { openHeight = panel.getBoundingClientRect().height; } panel.classList.add('closed'); }
  // eksponér toggle til den usynlige bundbjælke (DNA 2026-10-16)
  window.toggleBund = function () { isClosed() ? open() : close(); };

  // dobbeltklik på håndtaget (eller pilen) lukker/åbner
  handle.addEventListener('dblclick', (e) => {
    e.preventDefault();
    isClosed() ? open() : close();
  });
  if (chevron) chevron.addEventListener('dblclick', (e) => { e.stopPropagation(); isClosed() ? open() : close(); });
  if (chevron) chevron.addEventListener('click', (e) => { e.stopPropagation(); isClosed() ? open() : close(); });

  // træk kun i håndtaget når panelet er ÅBNT (min 96px)
  handle.addEventListener('mousedown', (e) => {
    if (isClosed()) { close(); return; }
    dragging = true;
    e.preventDefault();
    document.body.style.cursor = 'row-resize';
    document.body.style.userSelect = 'none';
  });
  document.addEventListener('mousemove', (e) => {
    if (!dragging) return;
    const rect = document.getElementById('wrap').getBoundingClientRect();
    const fromBottom = rect.bottom - e.clientY;
    const maxH = window.innerHeight * 0.7;
    const h = Math.max(96, Math.min(fromBottom, maxH));
    panel.style.height = h + 'px';
    openHeight = h;
  });
  document.addEventListener('mouseup', () => {
    dragging = false;
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
  });
})();

// ===== Noter — Obsidian via Ops (port 6122) =====
// Vieweren spørger Ops-tjenesten; den læser vaulten. Vi rører intet selv.
let noterCache = null;

async function toggleNoter() {
  const pane = document.getElementById('noter-pane');
  const meta = document.getElementById('bottom-meta');
  const scroll = document.getElementById('bottom-scroll');
  const tabs = document.getElementById('bottom-tabs');
  const panel = document.getElementById('bottom-panel');
  const knap = document.getElementById('noterBtn');
  if (!pane.hidden) {                       // luk
    pane.hidden = true;
    meta.style.display = ''; scroll.style.display = ''; tabs.style.display = '';
    if (knap) knap.classList.remove('active');
    return;
  }
  meta.style.display = 'none'; scroll.style.display = 'none'; tabs.style.display = 'none';
  pane.hidden = false;
  if (knap) knap.classList.add('active');
  panel.classList.remove('closed');
  if (!panel.style.height || parseInt(panel.style.height) < 200) panel.style.height = '300px';
  if (!noterCache) {
    document.getElementById('noter-tal').textContent = 'henter …';
    try {
      const svar = await fetch('/api/noter');
      const d = await svar.json();
      if (d.fejl) { document.getElementById('noter-tal').textContent = 'fejl: ' + d.fejl; return; }
      noterCache = d.noter || [];
    } catch (e) { document.getElementById('noter-tal').textContent = 'fejl: ' + e; return; }
  }
  visNoter(document.getElementById('noter-filter').value);
}

function visNoter(q) {
  q = (q || '').toLowerCase().trim();
  const liste = document.getElementById('noter-liste');
  const alle = noterCache || [];
  const noter = q ? alle.filter(n => (n.navn + ' ' + n.sti + ' ' + n.gruppe).toLowerCase().includes(q)) : alle;
  document.getElementById('noter-tal').textContent = noter.length + ' af ' + alle.length + ' noter';
  if (!noter.length) { liste.innerHTML = '<li class="tom">ingen noter fundet</li>'; return; }
  liste.innerHTML = '';
  for (const n of noter) {
    const li = document.createElement('li');
    li.title = n.sti;
    const b = document.createElement('b'); b.textContent = n.navn;
    const s = document.createElement('span'); s.textContent = n.gruppe;
    li.append(b, s);
    li.onclick = () => aabnNote(n.sti, li);
    liste.appendChild(li);
  }
}

async function aabnNote(sti, li) {
  const felt = document.getElementById('noter-tekst');
  felt.textContent = 'henter ' + sti + ' …';
  for (const el of document.querySelectorAll('#noter-liste li')) el.style.background = '';
  if (li) li.style.background = '#1e293b';
  try {
    const svar = await fetch('/api/note?sti=' + encodeURIComponent(sti));
    const d = await svar.json();
    felt.textContent = d.tekst || ('fejl: ' + (d.fejl || 'noten kunne ikke læses'));
  } catch (e) { felt.textContent = 'fejl: ' + e; }
}

