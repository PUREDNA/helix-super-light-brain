let searchTimer = null;
function applyFilter(q) {
  q = (q||'').trim();
  window.clearTimeout(searchTimer);
  if (!q) { applyHidden(); initNetwork(); return; }
  searchTimer = window.setTimeout(async () => {
    sætStatus('Søger i hele databasen...');
    try {
      let sdata = null;
      if (aktivHjerne === 'OPS') {
        sdata = søgLokalt(q);
