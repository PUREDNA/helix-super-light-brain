function vs_antal(t) {
  if (!t || t.indexOf('(henter') === 0) return '?';
  const m = /vektorer: (\d+)/.exec(t);
  if (m) return m[1];
  if (t.indexOf('ingen vektor') >= 0) return '0';
  return '?';
}

function setEl(id, v) { const el = document.getElementById(id); if (el) el.textContent = v; }

function formatTs(ts) {
  const n = Number(ts);
  let d;
  if (ts.length === 10) d = new Date(n * 1000);           // sekunder
  else if (ts.length === 13) d = new Date(n);              // millisekunder
  else { d = new Date(isNaN(n) ? 0 : n); }
  if (isNaN(d.getTime())) return String(ts);
  return d.toLocaleString('da-DK', { dateStyle: 'medium', timeStyle: 'short' });
}

