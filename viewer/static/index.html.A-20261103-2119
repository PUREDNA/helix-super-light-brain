<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Helix Light Brain</title>
<style>
  :root { --bg:#0f172a; --panel:#1e293b; --accent:#38bdf8; --text:#e2e8f0; --muted:#94a3b8; }
  * { box-sizing:border-box; }
  html,body { margin:0; height:100%; font-family:'Segoe UI',system-ui,sans-serif; background:var(--bg); color:var(--text); }
  #wrap { position:relative; height:100vh; display:flex; flex-direction:column; overflow:hidden; }
  #topbar { flex:0 0 auto; display:flex; align-items:center; gap:10px; padding:4px 12px; background:var(--panel); border-bottom:1px solid #334155; font-size:12px; color:var(--muted); z-index:30; flex-wrap:nowrap; overflow:visible; }
  #topbar .ttl { color:var(--accent); font-weight:600; font-size:13px; }
  #topbar #status { display:none; }
  #topbar .statsep { white-space:nowrap; }
  #topbar .grow { flex:1; }
  #topbar .grp { display:flex; gap:4px; white-space:nowrap; flex-shrink:0; }
  /* Brand-blok: titel + lysdiode, med noder/kanter i en lille linje under */
  .brand { display:flex; flex-direction:column; align-items:flex-start; gap:1px; line-height:1.15; white-space:nowrap; flex-shrink:0; }
  .brand-top { display:flex; align-items:center; gap:7px; }
  .brand-sub { font-size:10px; color:var(--muted); }
  .brand-sub b { color:var(--text); font-weight:600; }
  .led { width:9px; height:9px; border-radius:50%; display:inline-block; flex:0 0 auto; }
  .led.gul { background:#facc15; animation:ledblink 1s infinite; }
  .led.groen { background:#22c55e; }
  .led.roed { background:#ef4444; }
  @keyframes ledblink { 50% { opacity:.25; } }
  .ds-btn { background:#334155; color:var(--text); border:1px solid #475569; border-radius:8px; padding:5px 12px; font-size:12px; cursor:pointer; }
  .ds-btn:hover { filter:brightness(1.25); }
  .ds-btn.active { background:var(--accent); color:#06283d; border-color:var(--accent); font-weight:600; }
  /* Dropdown-gruppe i topbaren : Hjerne og Efterforskning
     folder sig ud og lader DNA vælge kilde hhv. undersøgelse. */
  .ds-drop { position:relative; display:inline-block; }
  .ds-menu { display:none; position:absolute; top:calc(100% + 4px); right:0; z-index:60;
             background:#1e293b; border:1px solid #475569; border-radius:8px; min-width:190px;
             box-shadow:0 8px 22px rgba(0,0,0,.55); overflow:hidden; }
  .ds-drop.open .ds-menu { display:block; }
  .ds-menu-item { display:flex; align-items:center; gap:8px; padding:8px 12px; font-size:12px;
                  color:var(--text); cursor:pointer; white-space:nowrap; }
  .ds-menu-item:hover { background:#334155; }
  .ds-menu-item.active { background:var(--accent); color:#06283d; font-weight:600; }
  .ds-menu-head { padding:6px 12px 4px; font-size:10px; letter-spacing:.06em;
                  text-transform:uppercase; color:var(--muted); }
  #filter { width:180px; padding:4px 10px; border-radius:6px; border:1px solid #334155; background:#0f172a; color:var(--text); font-size:12px; }
  #canvas { flex:1; position:relative; min-height:0; }
  #net { position:absolute; inset:0; }
  #legend-panel { position:fixed; top:42px; right:0; bottom:0; width:300px; background:var(--panel); border-left:1px solid #334155; box-shadow:-4px 0 16px rgba(0,0,0,.4); padding:14px; overflow-y:auto; transform:translateX(100%); transition:transform .2s ease; z-index:40; }
  #legend-panel.open { transform:translateX(0); }
  #legend-panel[hidden] { display:none; }
  /* Usynlig bjælke i højre side (DNA 2026-10-16): dobbeltklik åbner/lukker
     sidepanelet. 2 cm bred, usynlig, fuld højde under topbaren. */
  #side-tap { position:fixed; top:0; right:0; bottom:0; width:2cm; z-index:38; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  /* Usynlig bjælke i bunden (DNA 2026-10-16): dobbeltklik åbner/lukker
     bundpanelet. 2 cm høj, usynlig, fuld bredde. */
  #bottom-tap { position:fixed; left:0; right:0; bottom:0; height:2cm; z-index:38; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .tap-dot { width:12px; height:12px; border-radius:50%; background:var(--accent); opacity:.45; box-shadow:0 0 6px rgba(56,189,248,.55); transition:opacity .15s, transform .15s; }
  #side-tap:hover .tap-dot, #bottom-tap:hover .tap-dot { opacity:1; transform:scale(1.2); }

  #bottom-panel { height:240px; min-height:96px; max-height:70vh; background:#0b1220; border-top:1px solid #334155; display:flex; flex-direction:column; flex-shrink:0; flex-grow:0; z-index:20; }
  #bottom-handle { height:14px; cursor:row-resize; background:#1e293b; flex-shrink:0; display:flex; align-items:center; justify-content:center; user-select:none; }
  #bottom-handle .chev:hover { color:#38bdf8; }
  #handle-chevron { color:#475569; font-size:11px; line-height:1; cursor:pointer; width:18px; height:14px; display:flex; align-items:center; justify-content:center; }
  #bottom-panel.closed #bottom-body { display:none; }
  #bottom-panel.closed { height:14px !important; min-height:14px; }
  #bottom-panel.closed #handle-chevron { transform:rotate(180deg); }
  h1 { font-size:15px; margin:0 0 8px; color:var(--accent); }
  .stat { margin:6px 0; color:var(--muted); }
  .stat b { color:var(--text); }
  label.smol { display:block; margin-top:10px; color:var(--muted); }
  .row { display:flex; gap:6px; flex-wrap:wrap; }
  .icon-btn { width:34px; height:34px; padding:0; font-size:16px; border-radius:8px; background:#334155; color:var(--text); border:1px solid #475569; display:flex; align-items:center; justify-content:center; cursor:pointer; }
  .icon-btn:hover { filter:brightness(1.25); }
  .icon-btn.active { background:var(--accent); color:#06283d; border-color:var(--accent); }
  .lbl { margin:10px 0 4px; color:var(--muted); font-size:12px; }
  .legend { margin-top:8px; }
  .legend-item { display:flex; align-items:center; gap:8px; margin:3px 0; color:var(--muted); font-size:12px; cursor:pointer; user-select:none; border-radius:5px; padding:1px 4px; transition:background .12s, opacity .12s; }
  .legend-item.off { opacity:.35; }
  /* DNA 2026-10-02: tre funktioner på samme linje.
     peg = lys op i grafen · klik = hold fast · dobbeltklik = tænd/sluk */
  .legend-item.hover { background:#1e3a5f; }
  .legend-item.pinned { background:var(--accent); color:#06283d; font-weight:600; }
  .legend-item.pinned .legend-count { opacity:.85; }
  /* Skillelinje mellem Domæner (forælder) og Labels (barn) */
  .legend-rule { height:1px; background:#334155; margin:12px 0 4px; }
  .lbl-dom { color:#e2e8f0; font-weight:600; }
  .lbl-lab { color:#94a3b8; }
  /* AFSNITS-overskrift i labels — nu KLIKBAR :
     peg = lys op · enkeltklik = hold fast · dobbeltklik = tænd/sluk alt
     under kategorien. Ser ud som domænelinjerne. */
  .legend-child-of { margin:8px 0 2px; padding:3px 6px; color:#94a3b8; font-size:11px;
    text-transform:uppercase; letter-spacing:.4px; border-radius:4px;
    display:flex; align-items:center; gap:5px; cursor:pointer; user-select:none; }
  .legend-child-of:hover { background:#1e293b; color:#e2e8f0; }
  .legend-child-of.pinned { background:#334155; color:#fff; box-shadow:0 0 0 1px #38bdf8; }
  .legend-child-of .legend-count { margin-left:auto; opacity:.6; font-size:10px; }
  .legend-kid { padding-left:14px; }
  .dot { width:10px; height:10px; border-radius:50%; display:inline-block; flex-shrink:0; }
  .legend-count { font-size:10px; opacity:.7; margin-left:4px; }
  .legend-navn { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  /* STATUSLYS : grøn prik = tændt, mørk = slukket.
     Gælder ALLE linjer: domæne, afsnit, agent (forælder) og barn. */
  .status { width:9px; height:9px; border-radius:50%; flex:none;
    background:#334155; box-shadow:inset 0 0 0 1px #475569;
    transition:background .12s, box-shadow .12s; }
  .legend-item.on .status, .legend-child-of.on .status {
    background:#4ade80; box-shadow:0 0 7px #4ade80; }
  .legend-item.hover .status { transform:scale(1.25); }
  /* ●/○ som ekstra indikator — grøn når tændt */
  .legend-knap { font-size:13px; line-height:1; opacity:.75; padding:0 4px; border-radius:3px; flex:none;
    transition:color .12s, opacity .12s; }
  .legend-item.on .legend-knap { color:#4ade80; opacity:1; }
  .legend-item.off .legend-knap { color:#64748b; }
  /* Alt-eller-intet-knap pr. afsnit  */
  .alt-knap { font-size:10px; padding:2px 7px; margin-left:6px; border-radius:9px;
    background:#1e293b; color:#94a3b8; border:1px solid #334155; cursor:pointer;
    transition:background .12s, color .12s; vertical-align:middle; }
  .alt-knap:hover { background:#334155; color:#e2e8f0; }
  /* Label-overskrift + del-felter  */
  .legend-lab-head { background:#141c2b; border-left:2px solid #334155;
    padding-left:6px; margin-top:6px; font-weight:600; font-size:12px; }
  .legend-lab-head.on { border-left-color:#4ade80; }
  .legend-del { padding-left:26px; font-size:11px; color:#94a3b8; }
  .legend-del .legend-navn { font-weight:400; }
  #sel-info { margin-top:10px; font-size:12px; color:var(--muted); white-space:pre-wrap; word-break:break-word; border-top:1px solid #334155; padding-top:8px; }
  #tooltip { position:absolute; display:none; z-index:100; background:#0f172a; border:1px solid var(--accent); border-radius:6px; padding:6px 8px; font-size:11px; color:var(--text); max-width:320px; white-space:pre-wrap; word-break:break-word; pointer-events:none; box-shadow:0 4px 12px rgba(0,0,0,.5); }
  /* ===== Bundpanel (VS Code-terminal-stil) ===== */
  #bottom-panel { height:240px; min-height:96px; max-height:70vh; background:#0b1220; border-top:1px solid #334155; display:flex; flex-direction:column; }
  #bottom-handle { height:8px; cursor:row-resize; background:#1e293b; flex-shrink:0; display:flex; align-items:center; justify-content:center; user-select:none; }
  #bottom-handle::after { content:'⋯'; color:#475569; font-size:10px; letter-spacing:4px; }
  #bottom-body { display:flex; flex:1; min-height:0; }
  #bottom-meta { width:280px; flex-shrink:0; border-right:1px solid #334155; padding:10px; overflow-y:auto; font-size:12px; color:var(--muted); }
  #bottom-meta b { color:var(--text); }
  #bottom-content { flex:1; min-width:0; display:flex; flex-direction:column; }
  #bottom-tabs { display:flex; gap:4px; padding:6px 10px 0; background:#0f172a; border-bottom:1px solid #334155; flex-shrink:0; overflow-x:auto; }
  .btab { background:#1e293b; color:var(--muted); border:1px solid #334155; border-bottom:none; border-radius:6px 6px 0 0; padding:4px 12px; font-size:11px; cursor:pointer; }
  .btab.active { background:#0b1220; color:var(--text); border-color:var(--accent); }
  #bottom-scroll { flex:1; overflow:auto; padding:10px 14px; font-size:12px; color:var(--text); white-space:pre-wrap; word-break:break-word; line-height:1.5; }
  /* ===== Noter (Obsidian via Ops, port 6122) ===== */
  #noter-pane { flex:1; display:flex; flex-direction:column; min-height:0; }
  #noter-pane[hidden] { display:none; }
  #noter-hoved { display:flex; align-items:center; gap:10px; padding:6px 10px 4px; flex-shrink:0; }
  #noter-filter { flex:0 0 260px; background:#0f172a; color:var(--text); border:1px solid #334155; border-radius:6px; padding:4px 8px; font-size:12px; }
  #noter-tal { color:var(--muted); font-size:11px; }
  #noter-krop { flex:1; display:flex; gap:10px; min-height:0; padding:0 10px 8px; }
  #noter-liste { width:290px; flex-shrink:0; margin:0; padding:0; list-style:none; overflow:auto; border:1px solid #334155; border-radius:6px; background:#0b1220; }
  #noter-liste li { padding:5px 9px; font-size:12px; cursor:pointer; border-bottom:1px solid #1e293b; display:flex; justify-content:space-between; gap:8px; }
  #noter-liste li:hover { background:#1e293b; }
  #noter-liste li b { color:var(--text); font-weight:500; }
  #noter-liste li span { color:var(--muted); font-size:10px; white-space:nowrap; }
  #noter-liste li.tom { color:var(--muted); cursor:default; }
  #noter-tekst { flex:1; min-width:0; overflow:auto; padding:10px 13px; font:12.5px/1.65 ui-monospace,SFMono-Regular,Consolas,monospace; white-space:pre-wrap; word-break:break-word; background:#0b1220; border:1px solid #334155; border-radius:6px; color:var(--text); }
  .meta-row { margin:3px 0; }
  .meta-row .k { color:var(--muted); font-size:10px; text-transform:uppercase; letter-spacing:.4px; }
</style>
</head>
<body>

<div id="wrap">
  <div id="topbar">
    <span class="brand">
      <span class="brand-top">
        <span class="ttl">Helix Light Brain</span>
        <span class="led gul" id="led" title="Status"></span>
      </span>
      <span class="brand-sub">Noder <b id="stat-nodes">—</b> · Kanter <b id="stat-edges">—</b></span>
    </span>
    <span class="grow"></span>
    <span class="grp" title="Datasæt">
      <span class="ds-drop" id="drop-hjerne">
        <button class="ds-btn active" id="ds-hjerne" title="Super Brain: vælg kilde (Super Brains egen graf eller Obsidian)" onclick="toggleDrop('drop-hjerne')">🧠 Light Brain ▾</button>
        <div class="ds-menu">
          <div class="ds-menu-head">Vælg visning</div>
          <div class="ds-menu-item active" id="mi-ag" onclick="loadGraph(); lukDrop()">🧠 Light Brain <span style="color:var(--muted)">(database)</span></div>
          <div class="ds-menu-item" id="mi-ops" onclick="loadOps(); lukDrop()">🗂 OPS <span style="color:var(--muted)">(Obsidian)</span></div>
        </div>
      </span>
      <span class="ds-drop" id="drop-efter">
        <button class="ds-btn" id="ds-efterforskning" title="Undersøgelser — vælg en" onclick="toggleDrop('drop-efter')">🔎 Efterforskning ▾</button>
        <div class="ds-menu" id="drop-efter-menu">
          <div class="ds-menu-head">Undersøgelser</div>
          <div class="ds-menu-item" onclick="loadEfterforskning(); lukDrop()">🔎 Indlæser…</div>
        </div>
      </span>
    </span>
    <span class="grp" title="Visning og indstillinger">
      <span class="ds-drop" id="drop-visning">
        <button class="ds-btn" id="ds-visning" title="Grafiske visninger" onclick="toggleDrop('drop-visning')">🖼 Visning ▾</button>
        <div class="ds-menu">
          <div class="ds-menu-head">Grafiske visninger</div>
          <div class="ds-menu-item active" id="mi-mode-force" onclick="setMode('force'); lukDrop()">🕸 Flydende</div>
          <div class="ds-menu-item" id="mi-mode-radial" onclick="setMode('radial'); lukDrop()">◎ Radialt</div>
          <div class="ds-menu-item" id="mi-mode-tree" onclick="setMode('tree'); lukDrop()">🌳 Træ</div>
          <div class="ds-menu-item" id="mi-mode-grid" onclick="setMode('grid'); lukDrop()">▦ Gitter</div>
          <div class="ds-menu-item" onclick="fitToScreen(); lukDrop()">⛶ Fit to screen</div>
        </div>
      </span>
      <span class="ds-drop" id="drop-indstillinger">
        <button class="ds-btn" id="ds-indstillinger" title="Indstillinger" onclick="toggleDrop('drop-indstillinger')">⚙ Indstillinger ▾</button>
        <div class="ds-menu">
          <div class="ds-menu-head">Indstillinger</div>
          <div class="ds-menu-item" id="mi-loose" onclick="toggleLoose(); lukDrop()">◌ Noder uden tilhørsforhold</div>
          <div class="ds-menu-item" id="mi-edge" onclick="toggleEdges(); lukDrop()">⤳ Kanter</div>
          <div class="ds-menu-item" onclick="loadGraph(); lukDrop()">↻ Genindlæs graf</div>
          <div class="ds-menu-item" id="mi-noter" onclick="toggleNoter(); lukDrop()">📝 Noter</div>
        </div>
      </span>
    </span>
    <span class="grow"></span>
    <span class="statsep"><input id="filter" placeholder="Søg i noder..." oninput="applyFilter(this.value)"></span>
    <span id="status" title="Status">Indlæser...</span>
  </div>

  <div id="canvas"><div id="net"></div><div id="tooltip"></div></div>

  <div id="side-tap" title="Dobbeltklik for domæner/kategorier"><span class="tap-dot"></span></div>
  <div id="bottom-tap" title="Dobbeltklik for at åbne/lukke"><span class="tap-dot"></span></div>

  <div id="legend-panel">
    <div class="legend" id="legend"></div>
  </div>

  <div id="bottom-panel">
    <div id="bottom-handle" title="Dobbeltklik for at lukke/åbne">
      <span id="handle-chevron">▾</span>
    </div>
    <div id="bottom-body">
      <div id="bottom-meta">
        <div id="meta-name"><b>—</b></div>
        <div class="meta-row"><div class="k">Type</div><div id="meta-type">—</div></div>
        <div class="meta-row"><div class="k">Rolle</div><div id="meta-rolle">—</div></div>
        <div class="meta-row"><div class="k">Tidsstempel</div><div id="meta-timestamp">—</div></div>
        <div class="meta-row"><div class="k">Dato / dag</div><div id="meta-dato">—</div></div>
        <div id="meta-extra"></div>
      </div>
      <div id="bottom-content">
        <div id="bottom-tabs"></div>
        <div id="bottom-scroll">Klik på en node i grafen for at se dens indhold her.</div>
        <div id="noter-pane" hidden>
          <div id="noter-hoved">
            <input id="noter-filter" placeholder="Filtrér noter (navn eller mappe)..." oninput="visNoter(this.value)">
            <span id="noter-tal">—</span>
            <span style="color:#94a3b8;font-size:11px">Obsidian via Ops · port 6122</span>
          </div>
          <div id="noter-krop">
            <ul id="noter-liste"></ul>
            <article id="noter-tekst">Vælg en note i listen.</article>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/vis-network@9.1.9/standalone/umd/vis-network.min.js"></script>
<script>
// ===== Second Brain Graph Viewer (vis.js) — kvalitet, ikke lappeløsning =====
let dataAll = null;          // hele datasættet fra API
let filteredNodes = null;    // aktuelt vist udsnit
let filteredEdges = null;
let network = null;
let currentMode = 'force';
let hideLoose = false;
let hideEdges = false;
let hiddenGroups = new Set();
// DNA 2026-10-16: Samtalen (den rå maskin-log mellem DNA og Hermes) er tung og
// vokser eksplosivt — den hører ikke hjemme som standard-visning i grafen. Den
// skjules som udgangspunkt, men kan tændes manuelt (●/○) eller med "Vis alle".
const DEFAULT_SKJULT = ['Samtalen'];
let hiddenLabels = new Set();
let hiddenEdgeTypes = new Set();   // DNA 2026-10-16: slukkede kanttyper
let groupCounts = {};
const LS_KEY = 'sb-graph-prefs';
// DNA 2026-10-02: hvert DATASÆT (AG, OPS, Efterforskning) har sit EGET sæt af
// slukkede labels og tændte børn. Ellers smittede det ene datasæt af på det
// andet, og labels stod tændt når man skiftede. hiddenLabels/visteDele
// nedenfor er altid det AKTIVE datasæts sæt.
let hiddenLabelsAlle = {};   // { ds: [nøgler] }
let visteDeleAlle = {};      // { ds: [nøgler] }
let aktivDS = 'hjerne';

function savePrefs() {
  try {
    // Gem det aktive datasæts sæt tilbage i samlingen før lagring.
    hiddenLabelsAlle[aktivDS] = Array.from(hiddenLabels);
    visteDeleAlle[aktivDS] = Array.from(visteDele);
    localStorage.setItem(LS_KEY, JSON.stringify({
      hideLoose, hideEdges,
      hiddenGroups: Array.from(hiddenGroups),
      hiddenEdgeTypes: Array.from(hiddenEdgeTypes),
      hiddenLabelsAlle, visteDeleAlle,
      efterforskningFix: 2,
      currentMode
    }));
  } catch (e) { /* storage utilgængelig — ignorer */ }
}
function loadPrefs() {
  try {
    const raw = localStorage.getItem(LS_KEY);
    if (!raw) {
      // DNA 2026-10-16: ingen gemt tilstand endnu — start med Samtalen skjult.
      DEFAULT_SKJULT.forEach(g => hiddenGroups.add(g));
      return;
    }
    const p = JSON.parse(raw);
    hideLoose = !!p.hideLoose;
    hideEdges = !!p.hideEdges;
    currentMode = p.currentMode || 'force';
    hiddenGroups = new Set(Array.isArray(p.hiddenGroups) ? p.hiddenGroups.filter(Boolean) : []);
    hiddenEdgeTypes = new Set(Array.isArray(p.hiddenEdgeTypes) ? p.hiddenEdgeTypes.filter(Boolean) : []);
    hiddenLabelsAlle = p.hiddenLabelsAlle || {};
    visteDeleAlle = p.visteDeleAlle || {};
    // DNA 2026-10-16: Samtalen skal være skjult som udgangspunkt. Markøren
    // sikrer at vi kun pålægger defaulten ÉN gang — bagefter gælder brugerens
    // eget valg (tændt/slukket) fra localStorage.
    if (!p.samtalDefaultSat) {
      DEFAULT_SKJULT.forEach(g => hiddenGroups.add(g));
      p.samtalDefaultSat = true;
      try { localStorage.setItem(LS_KEY, JSON.stringify(p)); } catch (e) {}
    }
    // MIGRERING : en tidligere fejl lagde ALLE efterforsknings-
    // noder i skjulepositionen, så børnesagens graf var tom. Ryd den post.
    if (p.efterforskningFix !== 2) {
      delete hiddenLabelsAlle['efterforskning'];
      delete visteDeleAlle['efterforskning'];
    }
    // DNA 2026-10-17: ryd de gamle "alt er skjult"-poster ÉN gang,
    // saa grafen ikke staar tom for dem der har haft vieweren aaben foer.
    if (p.aabentFraStart !== 1) {
      hiddenLabelsAlle = {};
      visteDeleAlle = {};
      p.hiddenLabelsAlle = {};
      p.visteDeleAlle = {};
      p.aabentFraStart = 1;
