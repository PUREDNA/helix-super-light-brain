    document.getElementById('stat-nodes').textContent = dataAll.nodeCount;
    document.getElementById('stat-edges').textContent = dataAll.edgeCount;
    // DNA 2026-10-02: LABELS STARTER SKJULT pr. datasæt. Første gang du
    // åbner AG/OPS/Efterforskning står alle labels skjult — derefter
