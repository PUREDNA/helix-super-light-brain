        applyHidden(); initNetwork(); return;
      }
      filteredNodes = sdata.nodes;
      filteredEdges = sdata.edges;
      document.getElementById('stat-nodes').textContent = sdata.nodeCount;
      sætStatus('Fundet ' + sdata.nodeCount + ' noder');
      initNetwork();
    } catch (e) {
      sætStatus('Søgefejl: ' + e.message);
    }
  }, 400);
}

