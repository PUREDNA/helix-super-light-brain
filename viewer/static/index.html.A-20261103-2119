// byg vis.js nodes/edges fra data — med navne på noder OG kanter
function buildVis(nodes, edges) {
  // DNA 2026-10-16: tunge hub-noder (Samtalen, Dios børnesag) har så mange
  // kanter at de står og flakker. Giv dem masse der VOKSER GLIDENDE med antal
  // kanter — jo flere forbindelser, jo tungere node. Så falder de tunge til ro
  // af sig selv, mens de lette flyder frit. Reglen følger automatisk med til en
  // ny installation, fordi den kun kigger på antallet af kanter.
  const grad = {};
  edges.forEach(e => { grad[e.from] = (grad[e.from] || 0) + 1; grad[e.to] = (grad[e.to] || 0) + 1; });
  const massFor = id => {
    const g = grad[id] || 0;
    if (g <= 0) return 1;
    // glidende: én ekstra masseenhed pr. 50 kanter, loft ved 8.
    // DNA 3. nov 2026: loftet var 40, og "Projekter"-noden har 426 børn — den
    // blev så tung at tyngdekraften kastede den rundt, og man kunne ikke
    // klikke på den. Med loft 8 står tunge noder stille nok til at rammes,
    // uden at de lette noder begynder at flyve i stedet.
    return Math.min(1 + g / 50, 8);
  };
  return {
    nodes: nodes.map(n => ({
      id: String(n.id),
      label: n.label || '?',
      group: n.group || '?',
      mass: massFor(n.id),
      color: { border: '#0f172a', background: colorFor(n.group),
               highlight: { border: '#fff', background: '#f472b6' } },
      font: { color: '#e2e8f0', size: (typeof window !== 'undefined' && window.__erEfterforskning) ? 18 : 14,
              strokeWidth: (typeof window !== 'undefined' && window.__erEfterforskning) ? 3 : 0,
              strokeColor: '#0b1220' },
      title: (n.props && Object.keys(n.props).length)
        ? Object.keys(n.props).map(k => k + ': ' + String(n.props[k]).slice(0,200)).join('\n')
        : (n.label || '?')
    })),
    edges: edges.map(e => ({
      id: String(e.id),
      from: String(e.from),
      to: String(e.to),
      label: e.label || '',
      arrowStrikethrough: false,
      title: e.label || ''
    }))
  };
}

function initNetwork() {
  const container = document.getElementById('net');
  container.innerHTML = '<div id="tooltip" style="display:none"></div>';
  if (!filteredNodes || !filteredNodes.length) return;
  const data = buildVis(filteredNodes, filteredEdges || []);
  // radial: læg noder i cirkler pr. gruppe
  if (currentMode === 'radial') {
    const groups = {};
    data.nodes.forEach(n => { (groups[n.group] = groups[n.group] || []).push(n); });
    const keys = Object.keys(groups);
    const total = keys.length;
    let angle = 0;
    keys.forEach((g, i) => {
      const arr = groups[g];
      const radius = 180 + (i % 4) * 90;
      const a0 = (i / total) * Math.PI * 2;
      arr.forEach((n, j) => {
        const a = a0 + (j / Math.max(arr.length,1)) * 0.8;
        n.x = radius * Math.cos(a);
        n.y = radius * Math.sin(a);
      });
    });
  }
  if (currentMode === 'grid') {
    data.nodes.forEach((n, i) => { n.x = (i % 15) * 130; n.y = Math.floor(i / 15) * 130; });
  }
  network = new vis.Network(container, data, optionsFor(currentMode));
  window.gnet = network; // eksponér til test/fjernstyring
  // DNA 2026-10-16: fysikken skal ALTID være flydende, så noderne selv lægger
  // sig i klynger og mønstre. Vi fryser INTET — vi dæmper kun oscillationen
  // (damping + minVelocity i layoutet), så de noder der ellers ville stå og
  // flakke frem og tilbage, falder til ro. Trækker man i en node, følger dens
  // klynge med, fordi fysikken hele tiden er tændt.
  network.on('click', evt => {
    if (evt.nodes && evt.nodes.length) {
      const id = evt.nodes[0];
      const allNodes = filterFullNodes();
      const n = allNodes.find(x => String(x.id) === id);
      if (n) visNode(n);
    }
  });
  // DNA 2026-10-02: DOBBELTKLIK UDE I SELVE GRAFEN — samme system som i
  // sidebar'en, blot på den grafiske flade:
  //   dobbeltklik på en agent-boble  -> dens børn (ting) dukker frem
  //   dobbeltklik igen                -> de forsvinder igen
  //   dobbeltklik på et barn         -> kun det barn vises
  network.on('doubleClick', evt => {
    if (!evt.nodes || !evt.nodes.length) return;
    const n = filterFullNodes().find(x => String(x.id) === String(evt.nodes[0]));
    if (!n) return;
    grafDblKlik(n);
  });
  // NOTE: Ingen efterfølgende fit() her — den fik grafen til at hoppe tilbage
  // når DNA zoomede (zoom virkede ikke i noget mønster, 2026-09-16). Zoom/pan
  // er nu helt frit. Fit sker kun eksplicit via fitToScreen().
}

// grafDblKlik: tænd/sluk direkte fra grafen .
//   agent-boble  -> dens børn (ting) dukker frem; dobbeltklik igen = væk
//   barn-boble   -> kun det barn tændes/slukkes
// Agenten selv bliver STÅENDE i grafen, så man kan klikke igen.
function grafDblKlik(n) {
  const key = labelKey(n);
  const alle = (dataAll.nodes || []);
  if (n.arbejde === '1') {
    // Det er et BARN under en agent — tænd/sluk kun det.
    const dkey = key + '\u0001' + (n.del || '');
    if (visteDele.has(dkey)) {
      visteDele.delete(dkey);
    } else {
      visteDele.add(dkey);
      hiddenLabels.delete(key);            // forælderen skal vises
    }
    savePrefs(); applyHidden(); renderLegend(); initNetwork();
    return;
  }
  // Det er en AGENT (eller et domæne): tænd/sluk dens BØRN.
  const børn = [...new Set(alle
    .filter(x => labelKey(x) === key && x.arbejde === '1')
    .map(x => key + '\u0001' + (x.del || '')))];
  hiddenLabels.delete(key);                // agenten bliver stående
  const alleTændt = børn.length > 0 && børn.every(k => visteDele.has(k));
  if (alleTændt) {
    børn.forEach(k => visteDele.delete(k));      // skjul indholdet
  } else {
    børn.forEach(k => visteDele.add(k));         // vis indholdet
  }
  savePrefs(); applyHidden(); renderLegend(); initNetwork();
}

