// DNA 2026-10-02 — VIGTIGT: kun datasæt med forælder/barn-struktur (noder
// med et `age`-felt: OPS og AG) må starte med skjulte labels. Efterforskning
// (Flowsint) har INGEN age-felter — dér ville "skjul alle labels" skjule
// HELE grafen, fordi alle noder i en gruppe deler samme nøgle. Den fejl
// kostede en undersøgelse. Derfor tjekkes strukturen.
function skiftDatasæt(ds, nodes) {
  const harLabels = (nodes || []).some(n => 'age' in n && n.age);
  if (!(ds in hiddenLabelsAlle)) {
    // DNA 2026-10-16: Efterforskning skal ALTID starte med ALT synligt.
    // Den gamle graf har age-felter, men den er en undersøgelse man vil SE —
    // ikke et indeks man tænder op i. Ellers står efterforskningen tom.
    const startSkjult = false;   // DNA 2026-10-17: grafen maa ikke starte tom
    hiddenLabelsAlle[ds] = startSkjult ? (nodes || []).map(n => labelKey(n)) : [];
    visteDeleAlle[ds] = [];
  }
  aktivDS = ds;
  hiddenLabels = new Set(hiddenLabelsAlle[ds] || []);
  visteDele = new Set(visteDeleAlle[ds] || []);
}

const DEFAULT_SUBSET = 300;

const groupColors = [
  '#38bdf8','#f472b6','#a78bfa','#34d399','#fbbf24','#fb7185','#22d3ee','#a3e635',
  '#f97316','#64748b','#e879f9','#84cc16','#14b8a6','#f43f5e','#818cf8','#facc15'
];
const colorCache = {};
function colorFor(g) {
  g = String(g || '?');
  if (colorCache[g]) return colorCache[g];
  let h = 0;
  for (let i=0;i<g.length;i++) h = (h*31 + g.charCodeAt(i)) % 997;
  colorCache[g] = groupColors[h % groupColors.length];
  return colorCache[g];
}

function layoutFor(mode) {
  switch (mode) {
    case 'radial': return {
      hierarchical: { enabled: false },
      physics: false,
      // radial: manuel læg noder i cirkler pr. gruppe nedenfor
    };
    case 'tree': return {
      hierarchical: { enabled: true, direction: 'LR', sortMethod: 'directed',
                      nodeSpacing: 90, levelSeparation: 180, treeSpacing: 40 },
      physics: false
    };
    case 'grid': return {
      hierarchical: { enabled: false },
      physics: false
    };
    case 'force':
    default: {
      // DNA 2026-10-16: Efterforskningen skal have MERE LUFT end hjerne-grafen,
      // så labels ikke staar oven i hinanden. Samme flydende fysik, blot storre
      // fjederlaengde og mere frastodning. Hjernen (AG/OPS) er uaendret.
      const luftig = (typeof window !== 'undefined') && window.__erEfterforskning;
      return {
