function applyHidden() {
  if (!dataAll) return;
  // Domæne = forælder. Label = barn. Begge kan slukkes hver for sig.
  // DNA 2026-10-02: agenternes ARBEJDE (noder med arbejde='1') er skjult som
  // standard i OPS — grafen viser ellers hele arkivet i stedet for agenterne.
  // Det kommer frem når man tænder den enkelte agents label.
  let nodes = (dataAll.nodes||[]).filter(n => {
    const g = n.group, a = n.age || '';
    // Domæne slukket -> alt i det væk
    if (hiddenGroups.has(g)) return false;
    // Noder UDEN age (Efterforsknings-grafen) har ingen label-nøgle —
    // de skal ALTID vises .
    if (!n.age) return true;
    // Label slukket -> hele agenten (familien) væk
    if (hiddenLabels.has(g + '\u0000' + a)) return false;
    // Barn (agentens ting) -> vises kun hvis det er tændt enkeltvis
    if (n.arbejde === '1') {
      const dkey = g + '\u0000' + a + '\u0001' + (n.del || '');
      if (!visteDele.has(dkey)) return false;
    }
    // Barn slukket enkeltvis
    if (hiddenLabels.has(g + '\u0000' + a + '\u0001' + (n.del || ''))) return false;
    return true;
  });
  let edges = (dataAll.edges||[]).filter(e => !hideEdges);
  // DNA 2026-10-16: slukkede kanttyper filtreres fra — ligesom domæner.
  edges = edges.filter(e => !hiddenEdgeTypes.has(e.label || ''));
  const ids = new Set(nodes.map(n => String(n.id)));
  edges = edges.filter(e => ids.has(String(e.from)) && ids.has(String(e.to)));
  if (hideLoose) {
    const connected = new Set();
    edges.forEach(e => { connected.add(String(e.from)); connected.add(String(e.to)); });
    nodes = nodes.filter(n => connected.has(String(n.id)));
  }
  if (!hideLoose && edges.length > 0) {
    const degree = {};
    edges.forEach(e => { degree[e.from]=(degree[e.from]||0)+1; degree[e.to]=(degree[e.to]||0)+1; });
    nodes.sort((a,b) => (degree[b.id]||0) - (degree[a.id]||0));
    // DNA 2026-10-02: når et domæne/label er SLAKKET, skal det synlige sæt
    // respektere det — ellers forsvinder de få noder i mængden.
    // Er der slukket for noget, tages ALLE de tilbageværende med.
    // Desuden: er hele datasættet lille nok (fx OPS med ~465 noder), vises alt —
    // så fremhævning af et domæne rammer HELE domænet, ikke kun en delmængde.
    const nogetSlukket = hiddenGroups.size > 0 || hiddenLabels.size > 0;
    const lilleNok = (dataAll.nodes || []).length <= 800;
    if (!nogetSlukket && !lilleNok) {
      nodes = nodes.slice(0, DEFAULT_SUBSET);
      const subIds = new Set(nodes.map(n => String(n.id)));
      edges = edges.filter(e => subIds.has(String(e.from)) && subIds.has(String(e.to)));
    }
  }
  filteredNodes = nodes;
  filteredEdges = edges;
  document.getElementById('stat-nodes').textContent = nodes.length;
  document.getElementById('stat-edges').textContent = edges.length;
}

