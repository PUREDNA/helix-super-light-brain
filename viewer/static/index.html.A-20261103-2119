// Opdaterer man siden, kommer man tilbage til SAMME visning (Obsidian, hjernen
// eller efterforskningen) og SAMME node — ikke altid til graf-databasen.
async function genoptag() {
  let ds = 'hjerne', id = '';
  try {
    ds = localStorage.getItem('viewer_kilde') || 'hjerne';
    const s = JSON.parse(localStorage.getItem('viewer_sidste') || '{}');
    if (s && s.ds === ds && s.id) id = String(s.id);
  } catch (e) {}
  if (ds === 'ops') await loadOps();
  else if (ds === 'efterforskning') await loadEfterforskning();
  else await loadGraph();
  if (id) {
    const n = filterFullNodes().find(x => String(x.id) === id);
    if (n) {
      visNode(n);
      if (window.gnet) window.gnet.selectNodes([String(id)]);
    }
  }
}
