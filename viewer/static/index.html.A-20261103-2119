function naboerLokalt(n) {
  const alle = (dataAll && dataAll.nodes) || [];
  const kanter = (dataAll && dataAll.edges) || [];
  const id = String(n.id);
  const ramte = kanter.filter(e => String(e.from) === id || String(e.to) === id);
  if (!ramte.length) return { match: false, nodes: [], edges: [] };
  const naboIds = new Set();
  ramte.forEach(e => {
    const anden = (String(e.from) === id) ? String(e.to) : String(e.from);
    if (anden !== id) naboIds.add(anden);
  });
  const noder = [n].concat(
    alle.filter(x => naboIds.has(String(x.id)))
  );
  return {
    match: true,
    nodeCount: noder.length,
    edgeCount: ramte.length,
    nodes: noder,
    edges: ramte.map(e => ({ from: e.from, to: e.to, label: e.label })),
  };
}

function søgLokalt(q) {
  const needle = q.toLowerCase();
  const alle = (dataAll && dataAll.nodes) || [];
  const kanter = (dataAll && dataAll.edges) || [];
  const ramte = alle.filter(n => {
    const p = (n.props && typeof n.props === 'object') ? n.props : {};
    const tekst = [n.label, n.group, n.age, n.role, p.sti, p.titel]
      .concat(Object.values(p)).map(v => String(v == null ? '' : v)).join(' ').toLowerCase();
    return tekst.includes(needle);
  });
  const ids = new Set(ramte.map(n => String(n.id)));
  const eRamte = kanter.filter(e => ids.has(String(e.from)) && ids.has(String(e.to)));
  return { match: ramte.length > 0, nodeCount: ramte.length,
           edgeCount: eRamte.length, nodes: ramte,
           edges: eRamte.map(e => ({ from: e.from, to: e.to, label: e.label })) };
}

