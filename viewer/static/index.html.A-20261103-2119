// ===== Den nederste informationslinje: faneblade ===== (DNA 2026-10-17)
// Står her og ikke inde i showSelected, fordi flere grene af opbygningen
// slutter med et tidligt return — så blev rækkefølgen aldrig sat.
const faneTabs = document.getElementById('bottom-tabs');

// DNA 2026-10-17: fanebladene staar i fast raekkefoelge — sti, informationscenter,
    // mappe, MD, forbundet, oevrige — men DNA kan selv traekke dem rundt som i en
    // browser, og saa husker vi hans orden i browserens lager.
    const FANE_NOEGLE = 'sb-faneorden';
    const faneNavn = (k) => String(k.textContent || '').split(' (')[0].trim();
    const hentFaneOrden = () => {
      try { const r = JSON.parse(localStorage.getItem(FANE_NOEGLE) || '[]'); return Array.isArray(r) ? r : []; }
      catch (e) { return []; }
    };
    const gemFaneOrden = () => {
      try { localStorage.setItem(FANE_NOEGLE, JSON.stringify(Array.prototype.slice.call(faneTabs.children).map(faneNavn))); }
      catch (e) { }
    };
    const rydOpFaner = () => {
      const alleK = Array.prototype.slice.call(faneTabs.children);
      const navnAf = (k) => String(k.textContent || '');
      const mdHar = alleK.some(k => navnAf(k).indexOf('MD (') === 0 && navnAf(k) !== 'MD (0)');
      alleK.forEach(k => {
        k.draggable = true;   // DNA 2026-10-17: hvert faneblad kan tages og flyttes
        if (navnAf(k).indexOf('mapper (') === 0) k.textContent = 'mappe' + navnAf(k).slice('mapper'.length);
        if (mdHar && navnAf(k).indexOf('note (') === 0) k.remove();
      });
      const gemt = hentFaneOrden().map(x => x === 'øvrige' ? 'vektra-øvrig' : x);
      const grund = gemt.length ? gemt : ['sti', 'informationscenter', 'mappe', 'MD', 'forbundet', 'vektra-øvrig'];
      const kø = [];
      const nuK = Array.prototype.slice.call(faneTabs.children);
      grund.forEach(navn => {
        nuK.filter(k => navnAf(k).indexOf(navn) === 0).forEach(k => { if (kø.indexOf(k) < 0) kø.push(k); });
      });
      nuK.forEach(k => { if (kø.indexOf(k) < 0) kø.push(k); });   // nye faner lægges bagerst
      const nu = Array.prototype.slice.call(faneTabs.children);
      const ens = nu.length === kø.length && nu.every((k, i) => k === kø[i]);
      if (!ens) kø.forEach(k => faneTabs.appendChild(k));
      return kø;
    };
    // Traek-og-slip: tag et faneblad, slip det hvor det skal staa — og orden gemmes.
    if (!faneTabs.dataset.traek) {
      faneTabs.dataset.traek = '1';
      let traekK = null;
      const naermK = (maal) => (maal && maal.closest) ? maal.closest('.btab') : null;
      faneTabs.addEventListener('dragstart', (e) => {
        const k = naermK(e.target);
        if (!k) return;
        traekK = k;
        k.style.opacity = '.45';
        try { e.dataTransfer.setData('text/plain', faneNavn(k)); e.dataTransfer.effectAllowed = 'move'; } catch (err) { }
      });
      faneTabs.addEventListener('dragover', (e) => {
        if (!traekK) return;
        e.preventDefault();
        const over = naermK(e.target);
        if (!over || over === traekK) return;
        const boks = over.getBoundingClientRect();
        const efter = (e.clientX - boks.left) > boks.width / 2;
        faneTabs.insertBefore(traekK, efter ? over.nextSibling : over);
      });
      faneTabs.addEventListener('drop', (e) => {
        e.preventDefault();
        if (traekK) { traekK.style.opacity = ''; traekK = null; }
        gemFaneOrden();
      });
      faneTabs.addEventListener('dragend', () => {
        if (traekK) { traekK.style.opacity = ''; traekK = null; }
        gemFaneOrden();
      });
    }


